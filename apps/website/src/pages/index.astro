---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import HeroLattice from "../components/HeroLattice.astro";
import DownloadButton from "../components/DownloadButton.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AgentLogos from "../components/AgentLogos.astro";
import Showcase from "../components/Showcase.astro";
import WatchItWork from "../components/WatchItWork.astro";
import SetupGrid from "../components/SetupGrid.astro";
import LogoSprite from "../components/hero/LogoSprite.astro";
import AppPreview from "../components/mocks/AppPreview.astro";
import { getPublishedReleases, releaseAnchor } from "../data/changelog";
import { questions } from "../data/faq";
import { iphoneAppUrl } from "../data/downloads";
import "../styles/home.css";

const releases = (await getPublishedReleases()).slice(0, 4);
const releaseDate = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Layout>
  <SiteHeader />
  <main id="main" class="home-page">
    <LogoSprite />
    <section class="hero" aria-labelledby="hero-title">
      <HeroLattice />
      <div class="hero-copy">
        <h1 id="hero-title" class="hero-title" data-arrive>Your coding agents, <span class="quiet">working together.</span></h1>
        <div class="hero-actions" data-arrive style="--arrive-index: 1">
          <DownloadButton />
          <a class="hero-phone text-link" href={iphoneAppUrl} rel="noopener">Also on iPhone<Icon name="arrow" size={15} /></a>
        </div>
      </div>
    </section>

    <section class="app-preview-section container" aria-label="OpenOrc app preview">
      <div class="preview-window mock-window" role="group" aria-label="The OpenOrc app with three threads open in tabs. In the studio project, Codex has finished Make the first five minutes count, and the panel beside it holds its changes to src/Welcome.tsx, the project's files, and the new welcome screen in a browser. Claude is still working on A faster command menu, and Tell the product story has a finished result waiting.">
        <AppPreview />
      </div>
      <AgentLogos />
    </section>

    <Showcase />

    <WatchItWork />

    <section class="agents-section container" aria-labelledby="agents-title" data-reveal>
      <h2 id="agents-title" class="agents-statement"><span class="agents-lead">Built for the agents you already have.</span> Bring your subscriptions, API keys, and favorite coding agents.</h2>
    </section>

    <section class="setup-section container" id="your-tools" aria-labelledby="tools-title">
      <div class="section-heading" data-reveal>
        <h2 id="tools-title">Your setup stays yours.</h2>
        <p>Your accounts and agent configuration stay as they are.</p>
      </div>
      <SetupGrid />
    </section>

    {
      releases.length > 0 && (
        <section class="releases-section container" aria-labelledby="releases-title">
          <div class="releases-head" data-reveal>
            <h2 id="releases-title">Changelog</h2>
            <a class="text-link" href="/changelog/">See what’s new <Icon name="arrow" size={16} /></a>
          </div>
          <ol class="releases-grid">
            {releases.map((release, index) => (
              <li data-reveal style={`--reveal-index: ${index}`}>
                <a class="release-card" href={`/changelog/#${releaseAnchor(release.tag)}`}>
                  <span class="release-meta">
                    <span class="release-tag">{release.tag}</span>
                    {release.prerelease ? "Beta" : "Stable"}
                  </span>
                  {release.highlights[0] && <span class="release-summary">{release.highlights[0]}</span>}
                  <time datetime={release.publishedAt}>{releaseDate.format(new Date(release.publishedAt))}</time>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="faq-section container" id="questions" aria-labelledby="faq-title" data-reveal>
      <h2 id="faq-title">Good to know.</h2>
      <div class="faq-list">
        {questions.map(({ id, question, answer }) => (
          <details id={id}>
            <summary>{question}<Icon name="plus" size={16} /></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="closing container" aria-labelledby="closing-title" data-reveal>
      <h2 id="closing-title">Every agent. <span class="quiet">One workspace.</span></h2>
      <p>Start a conversation with the agents you already have, and keep every decision and review in one place.</p>
      <div class="hero-actions">
        <DownloadButton />
        <a class="button button-secondary" href="/docs/">Read how it works <Icon name="chevron" size={15} /></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

<script>
  // A question linked by its id, from the search or anywhere else, opens as the page lands on it.
  const openLinkedQuestion = () => {
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (target instanceof HTMLDetailsElement) target.open = true;
  };
  openLinkedQuestion();
  addEventListener("hashchange", openLinkedQuestion);
</script>
