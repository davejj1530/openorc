---
/**
 * The workflow demo. One question in a thread becomes three tasks; inside the
 * first task the user weighs two models against each other, asks one to build
 * it, and follows the change into the thread that starts. Content and timing:
 * data/hero/workflow.ts.
 */
import ChangeLine from "./ChangeLine.astro";
import Composer from "./Composer.astro";
import FileChips from "./FileChips.astro";
import ProductIcon from "./ProductIcon.astro";
import Prose from "./Prose.astro";
import Receipt from "./Receipt.astro";
import SceneFrame from "./SceneFrame.astro";
import Step from "./Step.astro";
import TaskPane from "./TaskPane.astro";
import TaskProperties from "./TaskProperties.astro";
import ThreadPane from "./ThreadPane.astro";
import TurnHead from "./TurnHead.astro";
import { busy, workflow, workflowJourney } from "../../data/hero/workflow";
import { branches, models, otherThreads, project } from "../../data/hero/workspace";
import { flagged, timed } from "../../data/hero/timeline";

interface Props {
  label: string;
}
const { label } = Astro.props;
const { thread, task, work } = workflow;
const at = (windows: string) => timed(workflowJourney, windows);
const head = { journey: workflowJourney };
const rows = [
  { id: "a", title: thread.title, providers: [{ harness: "codex", label: "Codex" }], busy: busy.a, waiting: "aQuestion~aPick", show: ">aSend" },
  { id: "b", title: work.title, branch: branches.cacheThread, providers: [{ harness: "codex", label: "Codex" }], busy: busy.b, show: ">bStart" },
];
const codex = { harness: "codex", label: models.codex.label, effort: models.codex.effort };
const starters = ["Explore this project", "Plan a change", "Review my changes"];
const options = [
  { name: task.mentions.codex, harness: "Codex" },
  { name: task.mentions.claude, harness: "Claude Code" },
];
const added = work.change.files.reduce((n, file) => n + file.added, 0);
const removed = work.change.files.reduce((n, file) => n + file.removed, 0);
/** Inline code in table cells and comments, as the app renders backticks. */
const code = (text: string) => text.split(/(`[^`]+`)/).map((part) => (part.startsWith("`") ? { code: true, text: part.slice(1, -1) } : { code: false, text: part }));
const comments = [
  { post: "askPost", to: task.mentions.codex, ask: task.comments.ask, reply: task.comments.codex, start: "codexStart", text: "codexText~codexEnd", end: "codexEnd" },
  { post: "secondPost", to: task.mentions.claude, ask: task.comments.second, reply: task.comments.claude, start: "claudeStart", text: "claudeText~claudeEnd", end: "claudeEnd" },
] as const;
---

<SceneFrame id="workflow" journey={workflowJourney} label={label} view="new" rows={rows} inboxPending="aQuestion~aPick">
  <div class="hs-panes" data-views>
    <section class="hs-pane" data-pane="new">
      <header class="hs-header">
        <span class="hs-header-actions"><span class="hs-round"><ProductIcon name="panelRight" /></span></span>
      </header>
      <div class="hs-new-body">
        <div class="hs-new-column">
          <div class="hs-new-question">What should we work on in {project.name}?</div>
          <Composer journey={workflowJourney} layout="new" placeholder="Ask OpenOrc to build, fix bugs, explore" model={codex} permission={models.codex.permission} prompt={{ text: thread.prompt, typo: thread.typo, window: "typeStart~typeEnd", typed: "typeStart~aSend" }} />
          <div class="hs-new-location"><ProductIcon name="branch" />Works in the local checkout on {project.branch}<ProductIcon name="chevronDown" /></div>
          <div class="hs-starters">{starters.map((starter) => <span class="hs-button hs-button-sm">{starter}</span>)}</div>
          <section class="hs-recent">
            <div class="hs-recent-label">Pick up where you left off</div>
            {otherThreads.map((recent) => <div class="hs-recent-row"><span class="hs-recent-title">{recent.title}</span><span class="hs-recent-meta">just now</span></div>)}
          </section>
        </div>
      </div>
    </section>

    <ThreadPane id="a" journey={workflowJourney} title={thread.title} busy={busy.a} model={codex} permission={models.codex.permission} placeholder="Message Codex…">
      <div class="hs-turn" data-grow {...at(">aSend")}>
        <div class="hs-user"><div class="hs-bubble">{thread.prompt}</div></div>
        <TurnHead {...head} harness="codex" agent="Codex" model={codex.label} clock={{ from: "aSend", writing: "aIntroStart", to: "aDone" }} />
        <Receipt
          {...head}
          thought={[
            { text: "Thinking", show: "<aThought" },
            { text: "Thought 1s", show: ">aThought" },
          ]}
          steps={[{ text: "1 step", show: ">aThought" }]}
        />
        <ol class="hs-steps" data-grow {...at("aSend~aDone")}>
          <Step
            {...head}
            title={[
              { text: "Thinking", show: "<aThought" },
              { text: thread.phase, show: ">aThought" },
            ]}
            live="<aRan"
            done=">aRan"
            meta={{ text: "6 files · 1 command", show: ">aRan" }}
            open="aThought~aRan"
          >
            <div data-grow {...at("aThought~aRead")}><FileChips label="Reading" files={thread.reads.map((path) => ({ path }))} /></div>
            <div data-grow {...at("aRead~aRan")}><FileChips label="Read" files={thread.reads.map((path) => ({ path }))} /></div>
            <div class="hs-group" data-grow {...at("aRead~aRan")}>
              <span class="hs-group-label">Running</span>
              <div class="hs-chips"><span class="hs-chip" data-live><ProductIcon name="terminal" class="hs-file-glyph" /><span class="hs-chip-label">{thread.command}</span></span></div>
            </div>
          </Step>
        </ol>
        <div class="hs-reply" data-grow {...at(">aIntroStart")}>
          <Prose text={thread.intro} stream="aIntroStart~aIntroEnd" />
          <div class="hs-table-wrap" data-grow {...at(">aTable")}>
            <div class="hs-table-tools"><span><ProductIcon name="copy" /></span><span><ProductIcon name="download" /></span><span><ProductIcon name="maximize" /></span></div>
            <table class="hs-table">
              <thead><tr>{thread.table.head.map((cell) => <th>{cell}</th>)}</tr></thead>
              <tbody>
                {thread.table.rows.map((row) => (
                  <tr>{row.map((cell) => <td>{code(cell).map((part) => (part.code ? <code>{part.text}</code> : part.text))}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
          <div data-grow {...at(">aOutroStart")}><Prose text={thread.outro} stream="aOutroStart~aOutroEnd" /></div>
        </div>
        <div class="hs-question" data-grow {...at(">aQuestion")}>
          <div class="hs-question-ask"><svg class="hs-logo" data-provider="codex" aria-hidden="true"><use href="#hs-logo-codex" /></svg>{thread.question.text}</div>
          <div class="hs-question-options">
            {thread.question.options.map((option, i) => (
              <div class="hs-question-option" {...flagged(workflowJourney, i === 0 ? { picked: "aSelect~aPick", chosen: ">aPick" } : { dropped: ">aPick" })}>
                <span class="hs-question-option-label"><span>{option.label}</span><span class="hs-question-option-description">{option.description}</span></span>
                <ProductIcon name="check" class="hs-question-check" />
              </div>
            ))}
          </div>
          <div class="hs-question-foot" {...at("<aPick")}>
            <span>Pick one</span>
            <span class="hs-text-button">Decline</span>
            <span class="hs-button hs-button-ink" {...flagged(workflowJourney, { disabled: "<aSelect" })}>Answer</span>
          </div>
          <div class="hs-question-foot" {...at(">aPick")}>Sent to Codex</div>
        </div>
      </div>
      <div class="hs-turn" data-grow {...at(">aPick")}>
        <TurnHead {...head} harness="codex" agent="Codex" model={codex.label} clock={{ from: "aPick", writing: "aCreatedStart", to: "aCreated" }} />
        <Receipt {...head} steps="1 step" />
        <ol class="hs-steps" data-grow {...at("aPick~aCreatedStart")}>
          <Step {...head} title="Creating the three tasks" live=">aPick" />
        </ol>
        <div class="hs-reply" data-grow {...at(">aCreatedStart")}><Prose text={thread.created} stream="aCreatedStart~aCreatedEnd" /></div>
        {workflow.tasks.map((item, i) => (
          <div class="hs-task-card" data-grow {...at(`>aCard${i + 1}`)}>
            <div class="hs-task-card-row">
              <ProductIcon name="delegate" />
              <span class="hs-task-card-title">{item.title}</span>
              <ProductIcon name="arrowUpRight" class="hs-task-card-open" />
            </div>
            <div class="hs-task-card-meta"><span>Backlog</span><span class="hs-task-card-branch"><ProductIcon name="branch" />{project.branch}</span><span>just now</span></div>
          </div>
        ))}
        <div class="hs-turn-actions" data-grow {...at(">aCreated")}><ProductIcon name="copy" /></div>
      </div>
    </ThreadPane>

    <TaskPane id="task" journey={workflowJourney} title={task.title} start="bStart" branch={branches.cacheThread}>
      <div class="hs-doc-title">{task.title}</div>
      <TaskProperties journey={workflowJourney} start="bStart" priority="High" />
      <div class="hs-spec">
        <h3>Goal</h3>
        <p>{task.spec.goal}</p>
        <h3>Scope</h3>
        <ul>{task.spec.scope.map((item) => <li>{code(item).map((part) => (part.code ? <code>{part.text}</code> : part.text))}</li>)}</ul>
        <h3>Acceptance criteria</h3>
        {task.spec.criteria.map((item) => (
          <div class="hs-check"><i></i><span>{item.text}</span></div>
        ))}
      </div>
      <div class="hs-labels"><span>Labels</span><span>{task.label}</span></div>

      <section class="hs-comments">
        <h3>Comments</h3>
        <p class="hs-comments-help">Mention a model to discuss this task. Clear work requests continue in a linked thread.</p>

        {comments.map((comment) => (
          <div class="hs-comment" data-grow {...at(`>${comment.post}`)}>
            <div class="hs-comment-meta"><strong>You</strong><time>just now</time></div>
            <div class="hs-comment-body">{comment.to} {comment.ask.text}</div>
            <span class="hs-comment-reply">Reply</span>
            <div class="hs-replies" data-grow {...at(`>${comment.start}`)}>
              <article class="hs-response">
                <div class="hs-comment-meta"><strong>{comment.reply.author}</strong><span>{comment.reply.meta}</span><time>just now</time></div>
                <div class="hs-comment-body"><Prose text={comment.reply.body} stream={comment.text} /></div>
                <p class="hs-comment-status" {...at(`<${comment.end}`)}>Replying…</p>
                <div class="hs-comment-actions"><span>Reply</span><span {...at(`<${comment.end}`)}>Cancel response</span></div>
              </article>
            </div>
          </div>
        ))}
        <div class="hs-comment" data-grow {...at(">buildPost")}>
          <div class="hs-comment-meta"><strong>You</strong><time>just now</time></div>
          <div class="hs-comment-body">{task.mentions.codex} {task.comments.build.text}</div>
          <span class="hs-comment-reply">Reply</span>
          <div class="hs-replies" data-grow {...at(">resultStart")}>
            <article class="hs-response">
              <div class="hs-comment-meta"><strong>{task.comments.result.author}</strong><span>{task.comments.result.meta}</span><time>just now</time></div>
              <div class="hs-comment-body"><Prose text={task.comments.result.body} stream="resultText~resultEnd" /></div>
              <p class="hs-comment-status" {...at("<bStart")}>Starting work…</p>
              <p class="hs-comment-status" {...at(">bStart")}>Working in thread</p>
              <div class="hs-comment-actions"><span>Reply</span><span {...at("<bStart")}>Cancel response</span><span {...at(">bStart")}>Open thread</span></div>
            </article>
          </div>
        </div>

        <div class="hs-comment-composer" {...flagged(workflowJourney, { typed: "askMention~askPost secondMention~secondPost buildMention~buildPost" })}>
          <div class="hs-comment-input">
            <span class="hs-placeholder">Leave a note, or type @ to ask a model…</span>
            <span {...at("askMention~askPick secondMention~secondPick buildMention~buildPick")}>@</span>
            <span {...at("askPick~askPost buildPick~buildPost")}>{task.mentions.codex} </span>
            <span {...at("secondPick~secondPost")}>{task.mentions.claude} </span>
            <span class="hs-typed" data-type="askTypeStart~askTypeEnd" data-text={task.comments.ask.text} data-typo={`${task.comments.ask.typo.at}:${task.comments.ask.typo.key}`} {...at("askTypeStart~askPost")} />
            <span class="hs-typed" data-type="secondTypeStart~secondTypeEnd" data-text={task.comments.second.text} data-typo={`${task.comments.second.typo.at}:${task.comments.second.typo.key}`} {...at("secondTypeStart~secondPost")} />
            <span class="hs-typed" data-type="buildTypeStart~buildTypeEnd" data-text={task.comments.build.text} data-typo={`${task.comments.build.typo.at}:${task.comments.build.typo.key}`} {...at("buildTypeStart~buildPost")} />
            <span class="hs-caret" {...at("askFocus~buildPost")} />
          </div>
          <div class="hs-mentions" data-grow {...at("askMention~askPick buildMention~buildPick")}>
            {options.map((option, i) => <div class="hs-option" data-selected={i === 0 ? "" : undefined}><span>{option.name}</span><span>{option.harness}</span></div>)}
          </div>
          <div class="hs-mentions" data-grow {...at("secondMention~secondPick")}>
            {options.map((option, i) => <div class="hs-option" data-selected={i === 1 ? "" : undefined}><span>{option.name}</span><span>{option.harness}</span></div>)}
          </div>
          <div class="hs-comment-composer-foot">
            <span class="hs-button hs-button-sm hs-comment-submit">Comment</span>
          </div>
        </div>
      </section>
    </TaskPane>

    <ThreadPane id="b" journey={workflowJourney} title={work.title} busy={busy.b} model={codex} permission={models.codex.permission} placeholder="Message Codex…" branch={branches.cacheThread} changes=">bDone" changeStat={{ added, removed }}>
      <div class="hs-turn">
        <div class="hs-user"><div class="hs-bubble">{work.prompt}</div></div>
        <TurnHead {...head} harness="codex" agent="Codex" model={codex.label} clock={{ from: "bStart", writing: "bReplyStart", to: "bDone" }} />
        <Receipt
          {...head}
          steps={[
            { text: "1 step", show: "<bRead" },
            { text: "2 steps", show: ">bRead" },
          ]}
        />
        <ol class="hs-steps" data-grow {...at("<bDone")}>
          <Step {...head} title={work.phases.read} live="<bRead" done=">bRead" meta={{ text: "4 files", show: ">bRead" }} />
          <Step {...head} grow {...at(">bRead")} title={work.phases.edit} live="<bEdited" done=">bEdited" meta={{ text: "3 files", show: ">bEdited" }} open="<bEdited">
            <FileChips label="Editing" files={work.change.files} live={work.change.files.at(-1)?.path} />
          </Step>
        </ol>
        <div class="hs-reply" data-grow {...at(">bReplyStart")}><Prose text={work.reply} stream="bReplyStart~bReplyEnd" /></div>
        <ChangeLine grow {...at(">bDone")} files={work.change.files.length} added={added} removed={removed} undo />
        <div class="hs-turn-actions" data-grow {...at(">bDone")}><ProductIcon name="copy" /></div>
      </div>
    </ThreadPane>
  </div>
</SceneFrame>
