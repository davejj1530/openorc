/**
 * The phone's look, generated from the desktop's own sources so the two cannot drift:
 *
 *   apps/desktop/src/renderer/src/app.css         :root rules, @theme static, @theme inline heights
 *   @openorc/client/theme           every palette, through resolveAccentColors
 *   apps/desktop/src/renderer/src/components/icons.tsx
 *   apps/desktop/src/renderer/src/assets/providers/*.svg, as HarnessLogo.tsx maps them
 *   apps/desktop/src/renderer/src/components/OpenOrcMark.tsx and workspace-design.css, for OpenOrc's mark
 *   apps/desktop/resources/icon.svg, the Dock icon the home-screen icon is drawn from
 *   the Shiki code themes RichText.tsx names
 *   apps/desktop/src/renderer/src/assets/fonts/*.woff2
 *
 * `design:sync` writes the outputs below; `design:check` regenerates them in memory and fails when any is stale.
 */
import { readFile, mkdir, writeFile } from "node:fs/promises";
import { dirname, relative, resolve } from "node:path";
import { format, resolveConfig } from "prettier";
import { themePresets } from "@openorc/client/theme";
import { paletteColors, resolvePalette, stylesheetColors, type Cascade, type Hex } from "./design-sync/colors.mts";
import { convertFonts, postScriptName } from "./design-sync/fonts.mts";
import { renderAppIcon } from "./design-sync/app-icon.mts";
import { renderHarnessLogos } from "./design-sync/harness-logos.mts";
import { renderIcons } from "./design-sync/icons.mts";
import { renderOpenOrcMark } from "./design-sync/openorc-mark.mts";
import { readSyntax } from "./design-sync/syntax.mts";
import { readStylesheet, type Scales } from "./design-sync/stylesheet.mts";

const app = resolve(import.meta.dirname, "..");
const desktop = resolve(app, "../desktop");
const renderer = resolve(desktop, "src/renderer/src");
// `--app-css=<file>` reads a copy instead, to prove the check fails without touching the desktop.
const appCss = process.argv.find((arg) => arg.startsWith("--app-css="))?.slice("--app-css=".length) ?? resolve(renderer, "app.css");
const desktopFonts = ["ImmaculateGothic-Text", "ImmaculateGothic-Bold"].map((face) => resolve(renderer, "assets/fonts", `${face}.woff2`));
// JetBrains Mono (OFL) is the desktop's code face; the phone embeds its static Regular cut.
const monoFont = resolve(app, "node_modules/@expo-google-fonts/jetbrains-mono/400Regular/JetBrainsMono_400Regular.ttf");
// The first frame paints the desktop's default palette; the Mac's own one replaces it at runtime (src/look).
const palette = "openorc";
const modes = ["light", "dark"] as const;
const header = "Generated by apps/mobile/scripts/design-sync.mts from the desktop's sources. Run `pnpm --filter @openorc/mobile design:sync`; do not edit.";

type Output = { path: string; contents: string | Uint8Array };
type Colors = Record<(typeof modes)[number], Record<string, Hex>>;
type Fonts = { text: string; bold: string; mono: string };
type Syntax = Awaited<ReturnType<typeof readSyntax>>;

function themeCss(colors: Colors, scales: Scales, fonts: Fonts): string {
  const variant = (mode: keyof Colors) => [`@variant ${mode} {`, ...Object.entries(colors[mode]).map(([token, value]) => `--color-${token}: ${value};`), "}"];
  const text = Object.entries(scales.text).flatMap(([step, { size, lineHeight, letterSpacing }]) => [
    `--text-${step}: ${size}px;`,
    `--text-${step}--line-height: ${lineHeight}px;`,
    `--text-${step}--letter-spacing: ${letterSpacing}px;`,
  ]);
  return [
    `/* ${header} */`,
    "@layer theme {",
    ":root {",
    ...variant("light"),
    ...variant("dark"),
    "}",
    "}",
    "@theme {",
    `--font-sans: "${fonts.text}";`,
    `--font-mono: "${fonts.mono}";`,
    ...text,
    ...Object.entries(scales.radius).map(([step, value]) => `--radius-${step}: ${value}px;`),
    ...Object.entries(scales.height).map(([step, value]) => `--height-${step}: ${value}px;`),
    "}",
  ].join("\n");
}

function tokensTs(colors: Colors, scales: Scales, fonts: Fonts, syntax: Syntax): string {
  const constant = (name: string, value: unknown) => `export const ${name} = ${JSON.stringify(value)} as const;`;
  return [
    `// ${header}`,
    constant("colors", colors),
    'export type ColorToken = keyof (typeof colors)["light"];',
    constant("text", scales.text),
    "export type TextStep = keyof typeof text;",
    constant("radius", scales.radius),
    constant("height", scales.height),
    constant("motion", scales.motion),
    constant("fonts", fonts),
    constant("syntax", syntax),
  ].join("\n");
}

/**
 * Every palette the phone can paint at runtime, as sources it resolves with src/look/paint.ts: the stylesheet's colors
 * and each palette's own, with lch() already written as hex. Each palette must paint the default's tokens.
 */
function palettesTs(cascade: Cascade, colors: Colors): string {
  const tokens = JSON.stringify(Object.keys(colors.light));
  for (const { id } of themePresets) {
    for (const mode of modes) {
      const painted = JSON.stringify(Object.keys(resolvePalette(id, mode, cascade)));
      if (painted !== tokens) throw new Error(`The ${id} palette paints ${painted} in ${mode}, not the default's ${tokens}`);
    }
  }
  const byMode = (read: (mode: (typeof modes)[number]) => Record<string, string>) => Object.fromEntries(modes.map((mode) => [mode, read(mode)]));
  const palettes = Object.fromEntries(themePresets.map(({ id }) => [id, byMode((mode) => paletteColors(id, mode))]));
  return [
    `// ${header}`,
    'import type { Mode, ThemePreset } from "@openorc/client/theme";',
    "",
    `export const stylesheet: Record<Mode, Readonly<Record<string, string>>> = ${JSON.stringify(byMode((mode) => stylesheetColors(cascade, mode)))};`,
    `export const palettes: Record<ThemePreset, Record<Mode, Readonly<Record<string, string>>>> = ${JSON.stringify(palettes)};`,
  ].join("\n");
}

/** app.json must embed exactly the faces tokens.ts names, or iOS silently falls back to the system font. */
async function checkEmbeddedFonts(paths: string[]): Promise<void> {
  const config = JSON.parse(await readFile(resolve(app, "app.json"), "utf8")) as { expo: { plugins: (string | [string, { fonts?: string[] }])[] } };
  const plugin = config.expo.plugins.find((entry): entry is [string, { fonts: string[] }] => Array.isArray(entry) && entry[0] === "expo-font");
  const embedded = (plugin?.[1].fonts ?? []).map((path) => resolve(app, path)).sort();
  const expected = [...paths].sort();
  if (JSON.stringify(embedded) !== JSON.stringify(expected)) {
    throw new Error(`app.json's expo-font plugin embeds ${JSON.stringify(embedded.map((path) => relative(app, path)))}, expected ${JSON.stringify(expected.map((path) => relative(app, path)))}`);
  }
}

async function formatted(path: string, source: string): Promise<Output> {
  const options = await resolveConfig(path);
  return { path, contents: await format(source, { ...options, filepath: path }) };
}

async function outputs(): Promise<Output[]> {
  const css = await readFile(appCss, "utf8");
  const { cascade, scales } = readStylesheet(css, appCss);
  const colors = Object.fromEntries(modes.map((mode) => [mode, resolvePalette(palette, mode, cascade)])) as Colors;
  const faces = await convertFonts(desktopFonts, resolve(app, "assets/fonts"));
  const fonts: Fonts = { text: faces[0]!.postScriptName, bold: faces[1]!.postScriptName, mono: postScriptName(await readFile(monoFont)) };
  await checkEmbeddedFonts([...faces.map((face) => face.path), monoFont]);
  const icons = await renderIcons(desktop);
  const marks = await renderHarnessLogos(renderer, css);
  const openOrcMark = await renderOpenOrcMark(renderer);
  const syntax = await readSyntax(desktop);
  const appIcon = await renderAppIcon(desktop);
  // app.json's ios.icon names this document.
  const iconDocument = resolve(app, "assets/OpenOrc.icon");
  const generated = resolve(app, "src/generated");
  return [
    await formatted(resolve(generated, "theme.css"), themeCss(colors, scales, fonts)),
    await formatted(resolve(generated, "tokens.ts"), tokensTs(colors, scales, fonts, syntax)),
    await formatted(resolve(generated, "palettes.ts"), palettesTs(cascade, colors)),
    await formatted(resolve(generated, "icons.tsx"), `// ${header}\n${icons}`),
    await formatted(resolve(generated, "harness-marks.ts"), `// ${header}\n${marks}`),
    await formatted(resolve(generated, "openorc-mark.ts"), `// ${header}\n${openOrcMark}`),
    await formatted(resolve(iconDocument, "icon.json"), appIcon.document),
    { path: resolve(iconDocument, "Assets/cube.svg"), contents: appIcon.cube },
    ...faces,
  ];
}

async function isCurrent({ path, contents }: Output): Promise<boolean> {
  const existing = await readFile(path).catch(() => null);
  return existing !== null && Buffer.compare(existing, Buffer.from(contents)) === 0;
}

const check = process.argv.includes("--check");
const all = await outputs();
const stale = (await Promise.all(all.map(async (output) => ((await isCurrent(output)) ? null : output)))).filter((output) => output !== null);
if (check) {
  if (stale.length) {
    console.error(`design:check: stale outputs (run pnpm --filter @openorc/mobile design:sync):\n${stale.map((output) => `  ${relative(app, output.path)}`).join("\n")}`);
    process.exit(1);
  }
  console.log(`design:check: ${all.length} outputs match the desktop's sources`);
} else {
  for (const output of stale) {
    await mkdir(dirname(output.path), { recursive: true });
    await writeFile(output.path, output.contents);
  }
  console.log(`design:sync: wrote ${stale.length} of ${all.length} outputs${stale.length ? `\n${stale.map((output) => `  ${relative(app, output.path)}`).join("\n")}` : ""}`);
}
