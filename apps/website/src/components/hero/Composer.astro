---
/**
 * The message composer as the app draws it (Composer.tsx): a white writing well inside a gray shell, the controls
 * row, and a footer with the conversation's folder beside its branch and any uncommitted changes.
 */
import ProductIcon from "./ProductIcon.astro";
import { project } from "../../data/hero/workspace";
import { timed, type Journey } from "../../data/hero/timeline";

interface Props {
  /** The scene's journey; stills pass none. */
  journey?: Journey;
  placeholder: string;
  model: { label: string; effort: string; harness?: string; icon?: "orchestration" };
  permission: string;
  branch?: string;
  /** Window during which uncommitted changes show beside the branch, with their counts; `true` for the whole scene. */
  changes?: string | boolean;
  changeStat?: { added: number; removed: number };
  /** The prompt this composer types, if any. */
  prompt?: { text: string; typo: { at: number; key: string }; window: string; typed: string };
  /** How much of the context window the conversation uses, as the ring shows it. Teams have none. */
  context?: number | null;
  /** The new-thread page's composer: white, the model first, and the attach button beside send. */
  layout?: "thread" | "new";
}
const { journey, placeholder, model, permission, branch = project.branch, changes, changeStat = { added: 8, removed: 2 }, prompt, context = 18, layout = "thread" } = Astro.props;
const fresh = layout === "new";
---

<div class="hs-composer" data-layout={layout} data-flag={prompt ? `typed:${prompt.typed}` : undefined}>
  <div class="hs-shell">
    <div class="hs-well">
      <span class="hs-placeholder hs-placeholder-idle">{placeholder}</span>
      <span class="hs-placeholder hs-placeholder-busy">Say it during this turn…</span>
      {prompt && journey ? <span class="hs-typed" data-type={prompt.window} data-text={prompt.text} data-typo={`${prompt.typo.at}:${prompt.typo.key}`} {...timed(journey, prompt.typed)} /> : null}
      {prompt ? <span class="hs-caret" /> : null}
    </div>
    <div class="hs-foot">
      {!fresh && <span class="hs-attach"><ProductIcon name="plus" /></span>}
      {!fresh && <span class="hs-picker">{permission}<ProductIcon name="chevronDown" /></span>}
      <span class="hs-model">
        {model.icon ? <ProductIcon name={model.icon} class="hs-model-icon" /> : <svg class="hs-logo" data-provider={model.harness} aria-hidden="true"><use href={`#hs-logo-${model.harness}`} /></svg>}
        <span class="hs-model-name">{model.label}</span>
        <span class="hs-model-effort">{model.effort}</span>
        <ProductIcon name="chevronDown" />
      </span>
      {fresh && <span class="hs-picker">{permission}<ProductIcon name="chevronDown" /></span>}
      <span class="hs-actions">
        {fresh && <span class="hs-attach"><ProductIcon name="plus" /></span>}
        {!fresh && context !== null ? (
          <span class="hs-context">
            <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" /><circle cx="8" cy="8" r="6" pathLength="100" stroke-dasharray={`${context} 100`} /></svg>
            {context}%
          </span>
        ) : null}
        <span class="hs-send">
          <ProductIcon name="arrowUp" class="hs-send-arrow" />
          <span class="hs-send-stop" />
        </span>
      </span>
    </div>
  </div>
  <div class="hs-location-rail">
    <span class="hs-directory"><ProductIcon name="laptop" /><span>/Projects/{project.name}</span></span>
    <div class="hs-checkout">
      <span class="hs-checkout-branch"><ProductIcon name="branch" /><span>{branch}</span></span>
      {changes ? (
        <span class="hs-checkout-changes" {...(typeof changes === "string" && journey ? timed(journey, changes) : {})}>
          <span class="hs-checkout-stat"><span class="hs-added">+{changeStat.added}</span><span class="hs-removed">−{changeStat.removed}</span></span>
          <span class="hs-checkout-commit">Commit<span class="hs-commit-suffix"> changes</span></span>
        </span>
      ) : null}
    </div>
  </div>
</div>
