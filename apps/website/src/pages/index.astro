---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import MeshGradient from "../components/MeshGradient.astro";
import DownloadButton from "../components/DownloadButton.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AgentLogos from "../components/AgentLogos.astro";
import Showcase from "../components/Showcase.astro";
import WatchItWork from "../components/WatchItWork.astro";
import SetupGrid from "../components/SetupGrid.astro";
import LogoSprite from "../components/hero/LogoSprite.astro";
import AppPreview from "../components/mocks/AppPreview.astro";
import LiquidWord from "../components/LiquidWord.astro";
import { getPublishedReleases, releaseAnchor } from "../data/changelog";
import "../styles/home.css";

const faqs = [
  ["What is OpenOrc?", "A desktop workspace for coding agents. Conversations, tasks, project context, and code review stay together across your projects."],
  ["Can I use my existing agents?", "Yes. OpenOrc works with the Codex, Claude Code, and OpenCode tools you already have installed, through their own sign-in and configuration. Provider subscriptions and API usage stay separate."],
  ["Where does my work live?", "Projects, conversation history, tasks, and project memory are stored on your computer. Each agent’s requests go to that agent’s provider, under its data policies. So do conversation titles, and run summaries once you turn memory on, unless you choose another provider in settings."],
  ["Does saving a task start work?", "No. A task waits in the backlog until you start it. Discuss it first, then begin when the approach is settled."],
  ["Can I review changes before they ship?", "Yes. The Changes panel sits beside the conversation. Read the diff, ask for another pass in the thread, then commit, push, or open a pull request when your Git setup supports it."],
  ["Does scheduled or Slack work run while OpenOrc is closed?", "No. Agents run on your computer. Keep OpenOrc open and your computer awake for scheduled work and Slack replies."],
];

/** The stage: neutral grays drifting slowly under a fine grain. */
const stage = {
  colors: { light: ["#f8f8f9", "#d3d6dd", "#eceef1", "#c6cad3"], dark: ["#121213", "#2e3035", "#0b0b0c", "#3a3c42"] },
  distortion: 0.8,
  swirl: 0.25,
  speed: 0.25,
  frame: 4000,
  grainMixer: 0.04,
  grainOverlay: 0.08,
};

const releases = (await getPublishedReleases()).slice(0, 4);
const releaseDate = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Layout>
  <SiteHeader />
  <main id="main" class="home-page">
    <LogoSprite />
    <section class="hero" aria-labelledby="hero-title">
      <MeshGradient class="hero-stage" {...stage}>
        <div class="hero-column">
          <div class="hero-copy">
            <h1 id="hero-title" class="hero-title" data-arrive><LiquidWord>Your coding agents,</LiquidWord> <span class="quiet">working together.</span></h1>
            <div class="hero-actions" data-arrive style="--arrive-index: 1">
              <DownloadButton />
              <AgentLogos />
            </div>
          </div>
          <div class="hero-window mock-window" role="img" aria-label="The OpenOrc app at rest. In the studio project, Codex has finished the thread Make the first five minutes count: a calmer welcome flow with one clear next step and keyboard support. The Changes panel beside it shows the edit to src/Welcome.tsx, 8 lines added and 2 removed, ready to commit." data-arrive style="--arrive-index: 2">
            <AppPreview />
          </div>
        </div>
      </MeshGradient>
    </section>

    <Showcase />

    <WatchItWork />

    <section class="agents-section container" aria-labelledby="agents-title" data-reveal>
      <h2 id="agents-title" class="agents-statement"><LiquidWord>Built for the agents you already have.</LiquidWord> Bring your Codex, Claude Code, or OpenCode subscriptions.</h2>
    </section>

    <section class="setup-section container" id="your-tools" aria-labelledby="tools-title">
      <div class="section-heading" data-reveal>
        <h2 id="tools-title">Your setup stays yours.</h2>
        <p>Your accounts and agent configuration stay as they are.</p>
      </div>
      <SetupGrid />
    </section>

    {
      releases.length > 0 && (
        <section class="releases-section container" aria-labelledby="releases-title">
          <div class="releases-head" data-reveal>
            <h2 id="releases-title">Changelog</h2>
            <a class="text-link" href="/changelog/">See what’s new <Icon name="arrow" size={16} /></a>
          </div>
          <ol class="releases-grid">
            {releases.map((release, index) => (
              <li data-reveal style={`--reveal-index: ${index}`}>
                <a class="release-card" href={`/changelog/#${releaseAnchor(release.tag)}`}>
                  <span class="release-meta">
                    <span class="release-tag">{release.tag}</span>
                    {release.prerelease ? "Beta" : "Stable"}
                  </span>
                  {release.highlights[0] && <span class="release-summary">{release.highlights[0]}</span>}
                  <time datetime={release.publishedAt}>{releaseDate.format(new Date(release.publishedAt))}</time>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="faq-section container" id="questions" aria-labelledby="faq-title" data-reveal>
      <h2 id="faq-title">Good to know.</h2>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}<Icon name="plus" size={16} /></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="closing container" aria-labelledby="closing-title" data-reveal>
      <h2 id="closing-title"><LiquidWord>Every agent.</LiquidWord> <span class="quiet">One workspace.</span></h2>
      <p>Start a conversation with the agents you already have, and keep every decision and review in one place.</p>
      <div class="hero-actions">
        <DownloadButton />
        <a class="button button-secondary" href="/docs/">Read how it works <Icon name="chevron" size={15} /></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
