---
/**
 * Across threads. Both threads are working. Asked to build the billing page,
 * Claude Code sees that the Plans migration thread is changing the data it
 * needs and asks it with thread_send; the question joins that thread's running
 * turn as a message notice, Codex answers the same way from its unmerged work
 * and goes back to the migration, and the answer starts a new turn that builds
 * the page against the new shape. Each turn shows its work as the app's steps
 * card while it runs, then folds behind its receipt. Content and timing:
 * data/hero/handoff.ts. With motion, blocks open with springs and each message
 * flies to the thread it reaches, opening into that thread's notice.
 */
import ChangeLine from "./ChangeLine.astro";
import FileChips from "./FileChips.astro";
import ProductIcon from "./ProductIcon.astro";
import Prose from "./Prose.astro";
import Receipt from "./Receipt.astro";
import SceneFrame from "./SceneFrame.astro";
import Step from "./Step.astro";
import ThreadPane from "./ThreadPane.astro";
import TurnHead from "./TurnHead.astro";
import { busy, handoff, threads } from "../../data/hero/handoff";
import { timed } from "../../data/hero/timeline";
import { branches } from "../../data/hero/workspace";

interface Props {
  label: string;
}
const { label } = Astro.props;
const { a, b } = threads;
const rows = [
  { id: "a", title: a.title, providers: [{ harness: a.harness, label: a.agent }], busy: busy.a, headline: a.headline },
  { id: "b", title: b.title, branch: branches.plansThread, providers: [{ harness: b.harness, label: b.agent }], busy: busy.b, headline: b.headline },
];
const at = (windows: string) => timed(handoff, windows);
const head = { journey: handoff };
---

<SceneFrame id="handoff" journey={handoff} label={label} view="a" rows={rows} motion>
  <div class="hs-panes" data-split>
    <ThreadPane
      id="a"
      journey={handoff}
      title={a.title}
      busy={busy.a}
      model={{ harness: a.harness, label: a.label, effort: a.effort }}
      permission={a.permission}
      placeholder={`Message ${a.agent}…`}
      changes=">aFinish"
      changeStat={a.change}
      prompt={{ text: a.prompt, typo: a.typo, window: "typeStart~typeEnd", typed: "typeStart~aSend" }}
    >
      <div class="hs-turn">
        <div class="hs-user"><div class="hs-bubble">{a.earlier.request}</div></div>
        <TurnHead harness={a.harness} agent={a.agent} model={a.label} took={a.earlier.took} />
        <Receipt {...a.earlier.receipt} />
        <div class="hs-reply"><Prose text={a.earlier.reply} /></div>
        <div class="hs-turn-actions"><ProductIcon name="copy" /></div>
      </div>

      <!-- First turn: read the settings pages, then ask the migration thread before building. -->
      <div class="hs-turn" data-grow {...at(">aSend")}>
        <div class="hs-user"><div class="hs-bubble">{a.prompt}</div></div>
        <TurnHead {...head} harness={a.harness} agent={a.agent} model={a.label} clock={{ from: "aSend", writing: "aAskedStart", to: "aDone" }} />
        <Receipt
          {...head}
          thought={[
            { text: "Thinking", show: "<aThought" },
            { text: "Thought 1s", show: ">aThought" },
          ]}
          steps={[
            { text: "1 step", show: "aThought~aSending" },
            { text: "2 steps", show: ">aSending" },
          ]}
        />
        <ol class="hs-steps" data-grow {...at("aSend~aDone")}>
          <Step
            {...head}
            title={[
              { text: "Thinking", show: "<aThought" },
              { text: a.phases.read, show: ">aThought" },
            ]}
            live="<aRead"
            done=">aRead"
            meta={{ text: "4 files", show: ">aRead" }}
          />
          <Step {...head} grow data-anchor="a-sending" {...at(">aSending")} title={a.phases.ask} live="<aAskedStart" done=">aAskedStart" open="<aAskedStart">
            <span class="hs-step-note">
              <ProductIcon name="workMessage" />
              <span {...at("<aSent")}>Sending message</span>
              <span {...at(">aSent")}>Sent message</span>
              <span class="hs-live" {...at("<aSent")}><ProductIcon name="loader" /></span>
            </span>
          </Step>
        </ol>
        <div class="hs-reply" data-grow {...at(">aAskedStart")}><Prose text={a.asked} stream="aAskedStart~aAskedEnd" /></div>
        <div class="hs-turn-actions" data-grow {...at(">aDone")}><ProductIcon name="copy" /></div>
      </div>

      <!-- The answer starts a new turn that builds the page against the new shape; the notice opens it. -->
      <div class="hs-turn" data-grow {...at(">bSent")}>
        <div class="hs-notice" data-anchor="a-notice">
          <ProductIcon name="workMessage" />
          <span class="hs-notice-body">
            <span class="hs-notice-head">{a.notice.head}</span>
            <span class="hs-notice-toggle">Show details</span>
          </span>
        </div>
        <TurnHead {...head} grow {...at(">aWork")} harness={a.harness} agent={a.agent} model={a.label} clock={{ from: "aWork", writing: "aResultStart", to: "aFinish" }} />
        <Receipt {...head} grow {...at(">aWork")} steps="1 step" />
        <ol class="hs-steps" data-grow {...at("aWork~aFinish")}>
          <Step {...head} title={a.phases.build} live="<aEdited" done=">aEdited" meta={{ text: "1 file", show: ">aEdited" }} open="<aEdited">
            <FileChips label="Editing" files={[a.change]} live={a.change.path} />
          </Step>
        </ol>
        <div class="hs-reply" data-grow {...at(">aResultStart")}><Prose text={a.result} stream="aResultStart~aResultEnd" /></div>
        <ChangeLine grow {...at(">aFinish")} files={1} added={a.change.added} removed={a.change.removed} undo />
        <div class="hs-turn-actions" data-grow {...at(">aFinish")}><ProductIcon name="copy" /></div>
      </div>
    </ThreadPane>

    <ThreadPane id="b" journey={handoff} title={b.title} busy={busy.b} model={{ harness: b.harness, label: b.label, effort: b.effort }} permission={b.permission} placeholder={`Message ${b.agent}…`} branch={branches.plansThread} changes changeStat={b.change}>
      <!-- Mid-migration when the scene opens: the message joins this turn, so its steps keep going. -->
      <div class="hs-turn">
        <div class="hs-user"><div class="hs-bubble">{b.request}</div></div>
        <TurnHead {...head} harness={b.harness} agent={b.agent} model={b.label} clock={{ from: "bStart" }} />
        <Receipt
          {...head}
          thought="Thought 6s"
          steps={[
            { text: "2 steps", show: "<bWork" },
            { text: "3 steps", show: "bWork~bDone" },
            { text: "4 steps", show: ">bDone" },
          ]}
        />
        <ol class="hs-steps">
          <Step title={b.phases.read} meta={{ text: "6 files · 2 searches" }} />
          <Step {...head} title={b.phases.migrate} live="<aSent" done=">aSent" meta={{ text: "3 files", show: ">aSent" }} open="<aSent">
            <FileChips label="Editing" files={b.edits} live={b.edits.at(-1)?.path} />
          </Step>
          <Step {...head} grow data-anchor="b-sending" {...at(">bWork")} title={b.phases.answer} live="<bDone" done=">bDone" open="<bDone">
            <div class="hs-step-narration" data-grow {...at(">bAnswerStart")}><Prose text={b.answer} stream="bAnswerStart~bAnswerEnd" /></div>
            <span class="hs-step-note" data-grow {...at(">bSending")}>
              <ProductIcon name="workMessage" />
              <span {...at("<bSent")}>Sending message</span>
              <span {...at(">bSent")}>Sent message</span>
              <span class="hs-live" {...at("<bSent")}><ProductIcon name="loader" /></span>
            </span>
          </Step>
          <Step {...head} grow {...at(">bDone")} title={b.phases.resume} live=">bDone" />
        </ol>
        <div class="hs-notice" data-grow data-anchor="b-notice" {...at(">aSent")}>
          <ProductIcon name="workMessage" />
          <span class="hs-notice-body">
            <span class="hs-notice-head">{b.notice.head}</span>
            <span class="hs-notice-details" data-grow {...at(">bDetails")}>{b.notice.details}</span>
            <span class="hs-notice-toggle" {...at("<bDetails")}>Show details</span>
            <span class="hs-notice-toggle" {...at(">bDetails")}>Hide details</span>
          </span>
        </div>
      </div>
    </ThreadPane>
  </div>
  <div class="hs-flight" data-from="a-sending" data-to="b-notice" data-start="aSending" data-land="aLand" aria-hidden="true" hidden><ProductIcon name="workMessage" /><span class="hs-flight-label">{a.flight}</span></div>
  <div class="hs-flight" data-from="b-sending" data-to="a-notice" data-start="bSending" data-land="bLand" aria-hidden="true" hidden><ProductIcon name="workMessage" /><span class="hs-flight-label">{b.flight}</span></div>
</SceneFrame>
