---
/** A product still on a tile, the app's own ground. The still is HTML from src/components/mocks/. */
interface Props {
  /** What the still shows, for people who cannot see it. */
  label: string;
  caption?: string;
}
const { label, caption } = Astro.props;
---

<figure class="docs-visual">
  <div class="stage docs-stage">
    <div class="mock-window" role="img" aria-label={label}>
      <slot />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
