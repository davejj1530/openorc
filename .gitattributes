# Match Prettier on every checkout, including Windows runners with autocrlf.
* text=auto eol=lf

# Preserve reviewed notice bytes on every platform.
/LICENSE -text
/NOTICE -text
/THIRD_PARTY_NOTICES.md -text
/licenses/** -text
/apps/website/public/licenses/** -text
/apps/desktop/src/renderer/src/assets/project-stacks/*.svg -text

# Terminal captures keep their carriage returns; the test-run reader reads them as a terminal printed them.
/packages/protocol/src/__fixtures__/test-runs/** -text
