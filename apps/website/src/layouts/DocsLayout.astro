---
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
import DocsNav from "../components/docs/DocsNav.astro";
import LogoSprite from "../components/hero/LogoSprite.astro";
import { docPage, docsReviewed, type DocSection } from "../data/docs";
import "../styles/docs.css";

interface Props {
  slug: string;
  /** The page's h2 sections, for the outline beside it. */
  sections?: DocSection[];
}

const { slug, sections = [] } = Astro.props;
const page = docPage(slug);
if (!page) throw new Error(`Unknown docs page: ${slug}`);
const home = slug === "";
---

<Layout title={home ? "OpenOrc documentation" : `${page.title} · OpenOrc docs`} description={page.description}>
  <SiteHeader />
  <LogoSprite />
  <main id="main" class:list={["container docs", { "docs-home": home }]}>
    <aside class="docs-nav">
      <DocsNav slug={slug} />
    </aside>

    <article class="docs-article">
      <details class="docs-menu">
        <summary>
          All documentation <Icon name="chevron" size={15} />
        </summary>
        <DocsNav slug={slug} />
      </details>
      <header class="docs-header">
        <h1>{page.title}</h1>
        <p class="docs-lead">{page.description}</p>
      </header>
      <slot />
      <p class="docs-reviewed">Checked against OpenOrc's source on {docsReviewed.date}.</p>
    </article>

    {
      sections.length > 0 && (
        <aside class="docs-toc">
          <nav aria-label="On this page">
            <ol>
              {sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>{section.title}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )
    }
  </main>
  <SiteFooter />
</Layout>

<script>
  import "../scripts/docs-outline";
</script>
