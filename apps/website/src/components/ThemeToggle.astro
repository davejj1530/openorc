---
/**
 * Light or dark for the whole site. Layout.astro applies the saved choice, or the system's, before the first paint;
 * this button flips it and remembers it.
 */
---

<button class="icon-button" type="button" aria-label="Dark mode" aria-pressed="false" data-theme-toggle>
  <span class="icon-swap">
    <svg data-icon="moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
    <svg data-icon="sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
  </span>
</button>

<script>
  import { setSiteTheme, siteTheme } from "../scripts/site-theme";

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const moon = button.querySelector<SVGElement>('[data-icon="moon"]');
    const sun = button.querySelector<SVGElement>('[data-icon="sun"]');
    // The button shows where it goes: a moon in light mode, a sun in dark.
    const show = () => {
      const dark = siteTheme() === "dark";
      button.setAttribute("aria-pressed", String(dark));
      moon?.toggleAttribute("data-off", dark);
      sun?.toggleAttribute("data-off", !dark);
    };
    show();
    button.addEventListener("click", () => {
      const next = siteTheme() === "dark" ? "light" : "dark";
      setSiteTheme(next);
      show();
    });
  }
</script>
