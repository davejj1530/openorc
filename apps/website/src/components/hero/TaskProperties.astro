---
/** A task's properties as the document's chips (TaskDocument.tsx): status until work starts and after, priority, project. */
import ProductIcon from "./ProductIcon.astro";
import StatusMark from "./StatusMark.astro";
import { project } from "../../data/hero/workspace";
import { timed, type Journey } from "../../data/hero/timeline";

interface Props {
  journey: Journey;
  /** Moment the task's work starts. */
  start: string;
  priority: "High" | "Medium";
}
const { journey, start, priority } = Astro.props;
---

<div class="hs-props">
  <span class="hs-prop hs-prop-select" {...timed(journey, `<${start}`)}><StatusMark status="backlog" /><span>Backlog</span><ProductIcon name="chevronDown" class="hs-prop-chevron" /></span>
  <span class="hs-prop hs-prop-select" {...timed(journey, `>${start}`)}><StatusMark status="in_progress" /><span>In progress</span><ProductIcon name="chevronDown" class="hs-prop-chevron" /></span>
  <span class="hs-prop hs-prop-select"><ProductIcon name={priority === "High" ? "signalHigh" : "signalMedium"} /><span>{priority}</span><ProductIcon name="chevronDown" class="hs-prop-chevron" /></span>
  <span class="hs-prop">{project.name}</span>
</div>
<div class="hs-editor-controls">
  <span class="hs-round"><ProductIcon name="plus" /></span>
  <span class="hs-round"><ProductIcon name="image" /></span>
  <span class="hs-editor-mode">Markdown</span>
</div>
