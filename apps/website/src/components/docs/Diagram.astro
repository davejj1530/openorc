---
import type { DiagramSpec } from "../../data/docs/diagrams";

interface Props {
  diagram: DiagramSpec;
}

const { diagram } = Astro.props;
const variants = [
  ["wide", diagram.wide],
  ["narrow", diagram.narrow],
] as const;
---

<figure class="docs-diagram" id={`${diagram.id}-diagram`}>
  {variants.map(([variant, drawing]) => {
    const id = `${diagram.id}-${variant}`;
    return (
      <svg class={`diagram-${variant}`} viewBox={`0 0 ${drawing.width} ${drawing.height}`} role="img" aria-labelledby={`${id}-title ${id}-desc`}>
        <title id={`${id}-title`}>{diagram.title}</title>
        <desc id={`${id}-desc`}>{diagram.description}</desc>
        <defs>
          <marker id={`${id}-arrow`} markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto-start-reverse" markerUnits="userSpaceOnUse">
            <path d="M1 1 L6 3.5 L1 6" fill="none" stroke="var(--muted)" stroke-width="1.25" />
          </marker>
        </defs>
        <g aria-hidden="true">
          {drawing.groups?.map((group) => (
            <g>
              <rect class="diagram-group" x={group.x} y={group.y} width={group.w} height={group.h} rx="12" />
              <text class="diagram-group-label" x={group.x + 16} y={group.y + 24}>
                {group.label}
              </text>
            </g>
          ))}
        </g>
        <g class="diagram-edges" aria-hidden="true">
          {drawing.edges.map((edge) => (
            <path d={edge.path} stroke-dasharray={edge.dashed ? "5 5" : undefined} marker-end={`url(#${id}-arrow)`} marker-start={edge.both ? `url(#${id}-arrow)` : undefined} />
          ))}
        </g>
        <g aria-hidden="true">
          {drawing.labels?.map((label) => (
            <g class="diagram-edge-label">
              <rect x={label.x - label.width / 2} y={label.y - 14} width={label.width} height="20" />
              <text x={label.x} y={label.y} text-anchor="middle">
                {label.text}
              </text>
            </g>
          ))}
          {drawing.nodes.map((node) => (
            <g class:list={["diagram-node", { "diagram-emphasis": node.emphasis, "diagram-compact": node.compact }]}>
              <rect class="diagram-node-shape" x={node.x} y={node.y} width={node.w} height={node.h} rx="8" />
              <text class="diagram-node-title" x={node.x + node.w / 2} y={node.y + node.h / 2 + (node.sub ? -6 : 5)} text-anchor="middle">
                {node.label}
              </text>
              {node.sub && (
                <text class="diagram-node-sub" x={node.x + node.w / 2} y={node.y + node.h / 2 + 17} text-anchor="middle">
                  {node.sub}
                </text>
              )}
            </g>
          ))}
        </g>
      </svg>
    );
  })}
  <figcaption>{diagram.caption}</figcaption>
</figure>
