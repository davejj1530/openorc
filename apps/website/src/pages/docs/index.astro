---
import DocsLayout from "../../layouts/DocsLayout.astro";
import DocsVisual from "../../components/docs/DocsVisual.astro";
import LinkCards from "../../components/docs/LinkCards.astro";
import WorktreeMock from "../../components/mocks/WorktreeMock.astro";

const sections = [
  { id: "start-here", title: "Start here" },
  { id: "what-you-can-do", title: "What you can do" },
  { id: "more-resources", title: "More resources" },
];

const startHere = [
  { slug: "quickstart" },
  { slug: "concepts" },
  { href: "/download/", title: "Download", description: "Installers for macOS, Windows, and Linux. OpenOrc is free and open source, with no account to create." },
];

const tasks = [
  { slug: "threads", title: "Work with an agent", description: "Start a thread, steer the agent while it works, and keep up to three threads open side by side." },
  { slug: "tasks", title: "Plan the work", description: "Write tasks with a spec and a priority, and start each one when you are ready." },
  { slug: "review", title: "Review every change", description: "Read the diff beside the conversation, then commit, push, or open a pull request." },
  { slug: "git", title: "Keep parallel work apart", description: "Give a thread its own branch and folder, so threads working at once don't edit the same files." },
  { slug: "memory", title: "Keep what you learn", description: "Save decisions and lessons from finished work, so the next thread starts with them." },
  { slug: "messaging", title: "Let threads work together", description: "Threads can message each other and start helper threads that work in the same folder." },
];

const resources = [
  { href: "/changelog/", title: "Changelog", description: "What changed in each release." },
  { href: "https://github.com/davejj1530/openorc", title: "GitHub", description: "The source code, releases, and issue tracker." },
  { slug: "troubleshooting" },
];
---

<DocsLayout slug="" sections={sections}>
  <DocsVisual
    art="hero"
    label="OpenOrc with threads from three projects in the sidebar, one of them still working. The open thread runs Codex in its own worktree. Its reply says every color, radius, and spacing step now comes from one tokens.css file, and the row under the composer names the branch, openorc/design-tokens-2c91f0, with 12 lines added, 4 removed, and a Commit changes button."
  >
    <WorktreeMock />
  </DocsVisual>

  <section aria-labelledby="start-here">
    <h2 id="start-here">Start here</h2>
    <LinkCards cards={startHere} columns={3} />
  </section>

  <section aria-labelledby="what-you-can-do">
    <h2 id="what-you-can-do">What you can do</h2>
    <LinkCards cards={tasks} />
  </section>

  <section aria-labelledby="more-resources">
    <h2 id="more-resources">More resources</h2>
    <LinkCards cards={resources} columns={3} />
  </section>
</DocsLayout>
