{
  "name": "@openorc/desktop",
  "version": "0.1.0-beta.8",
  "license": "Apache-2.0",
  "private": true,
  "description": "Desktop workspace for coding-agent conversations, tasks, and changes.",
  "homepage": "https://openorc.app",
  "desktopName": "openorc.desktop",
  "main": "./out/main/index.mjs",
  "scripts": {
    "icons:build": "node scripts/build-app-icon.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --dir",
    "package:smoke": "electron-vite build && electron-builder --dir --config electron-builder.smoke.cjs",
    "package:linux": "electron-vite build && electron-builder --linux --config electron-builder.linux.cjs --publish never",
    "release:build": "electron-vite build && electron-builder --config electron-builder.release.cjs --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "postinstall": "node ../../scripts/fix-pty-helper.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openorc/agents": "workspace:*",
    "@openorc/core": "workspace:*",
    "@openorc/mcp": "workspace:*",
    "@openorc/protocol": "workspace:*",
    "@pierre/diffs": "1.4.2",
    "@rive-app/canvas": "2.42.1",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-virtual": "^3.14.0",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.0",
    "electron-updater": "^6.8.9",
    "fastembed": "2.1.0",
    "image-size": "^2.0.4",
    "js-yaml": "4.3.2",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "1.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sqlite-vec": "0.1.9",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.3.0",
    "typegpu": "^0.12.5",
    "vgpu": "^0.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@openorc/db": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.72",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "unplugin-typegpu": "^0.12.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
