+/**
+ * A sandboxed page is untrusted, so the web view keeps it from reaching anything outside itself, below the page's own
+ * policy: WebKit does not hold WebRTC, `<link rel=preconnect>` or the connection it opens to a link's host as the link
+ * is followed (before any navigation policy is asked) to a content security policy.
+ *
+ * - Lockdown Mode, which takes WebRTC away along with other features an untrusted page has no need for.
+ * - Content rules that refuse every http(s) and ws(s) load WebKit checks against them, `<link rel=preconnect>` too.
+ * - One ephemeral data store for every sandboxed page of the app session (making and dropping one per page costs the
+ *   UI thread a frame or two; its pages have opaque origins and keep nothing in it), whose connections all go through
+ *   a proxy at port 0 of the phone, where nothing can listen, with no way around it: a followed link's host is never
+ *   reached or looked up. The system never proxies the phone's own addresses or link-local ones (169.254.0.0/16), so a
+ *   link a page clicks outside its document can still open a connection to those, though nothing is sent on it.
+ * - JavaScript dialogs answered at once, as a sandboxed frame without allow-modals answers them, so a page can neither
+ *   put a native alert over the app nor ask the reader for text.
+ *
+ * A system without data store proxies (before iOS 17) cannot keep a page from the network, so it does not load one.
+ */
+static NSString *const SandboxRulesIdentifier = @"RNCWebViewSandbox";
+static NSString *const SandboxRules = @"[{\"trigger\":{\"url-filter\":\"^https?:\"},\"action\":{\"type\":\"block\"}},{\"trigger\":{\"url-filter\":\"^wss?:\"},\"action\":{\"type\":\"block\"}}]";
+
+/** The data store every sandboxed page shares for the app session, with no way to the network. */
+static WKWebsiteDataStore *RNCSandboxDataStore(void)
+{
+  static WKWebsiteDataStore *store;
+  if (!store) {
+    store = [WKWebsiteDataStore nonPersistentDataStore];
+    if (@available(iOS 17.0, macOS 14.0, *)) {
+      nw_proxy_config_t nowhere = nw_proxy_config_create_http_connect(nw_endpoint_create_host("127.0.0.1", "0"), nil);
+      nw_proxy_config_set_failover_allowed(nowhere, false);
+      store.proxyConfigurations = @[nowhere];
+    }
+  }
+  return store;
+}
+
+/** Hands `ready` the sandbox's rules, compiled once for the app; nil if they could not compile. */
+static void RNCWithSandboxRules(void (^ready)(WKContentRuleList *_Nullable rules))
+{
+  static WKContentRuleList *compiled;
+  static NSMutableArray *waiting;
+  if (compiled) {
+    ready(compiled);
+    return;
+  }
+  if (waiting) {
+    [waiting addObject:ready];
+    return;
+  }
+  waiting = [NSMutableArray arrayWithObject:ready];
+  [WKContentRuleListStore.defaultStore compileContentRuleListForIdentifier:SandboxRulesIdentifier encodedContentRuleList:SandboxRules completionHandler:^(WKContentRuleList *rules, NSError *error) {
+    compiled = rules;
+    NSArray *blocks = waiting;
+    waiting = nil;
+    for (void (^block)(WKContentRuleList *) in blocks) {
+      block(rules);
+    }
+  }];
+}
