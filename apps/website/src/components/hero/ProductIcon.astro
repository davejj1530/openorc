---
/** A glyph from the desktop app's icon set, by the app's own name for it (data/product-icons.ts, generated from icons.tsx). */
import { productIcons, type ProductIconName } from "../../data/product-icons";

export type IconName = ProductIconName;

interface Props extends Record<string, unknown> {
  name: IconName;
  class?: string;
}
const { name, class: className, ...rest } = Astro.props;
---

<svg class:list={["hs-icon", className]} {...rest} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={productIcons[name]} />
