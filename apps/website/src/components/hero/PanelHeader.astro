---
/**
 * The work panel's header on the window's top line (PanelHeader.tsx, PanelTabs.tsx): its pages as tabs drawn like the
 * work column's, each as wide as its name, then the add button, and expand at the far end.
 */
import ProductIcon from "./ProductIcon.astro";
import WorkTab, { type Tab } from "./WorkTab.astro";

interface Props {
  /** A page's tab shows its tool's icon, or a file page its file's glyph. */
  tabs: (Tab & { icon: NonNullable<Tab["icon"]> } | Tab & { file: string })[];
  /** Names the tabs as a tablist, for tabs the visitor can pick. */
  tablist?: string;
}
const { tabs, tablist } = Astro.props;
---

<div class="hs-panel-header">
  <span class="hs-panel-tabs" role={tablist ? "tablist" : undefined} aria-label={tablist}>
    {tabs.map((tab) => <WorkTab {...tab} />)}
  </span>
  <span class="hs-round" aria-hidden="true"><ProductIcon name="plus" /></span>
  <span class="hs-round hs-panel-expand" aria-hidden="true"><ProductIcon name="expand" /></span>
</div>
