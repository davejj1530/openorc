---
/**
 * One conversation pane as the app draws it (ThreadView.tsx): its header on the window's top line, then the
 * conversation. The first pane's header holds the work column's tabs, by default one for its own thread; a pane split
 * beside it names its thread instead.
 */
import ThreadBody from "./ThreadBody.astro";
import ThreadHeader from "./ThreadHeader.astro";
import type { Tab } from "./WorkTab.astro";
import { flagged } from "../../data/hero/timeline";
import type { ComponentProps } from "astro/types";

type BodyProps = ComponentProps<typeof ThreadBody>;

interface Props extends BodyProps {
  id: string;
  title: string;
  /** Windows during which the thread's agent is working; stills pass none. */
  busy?: string;
  /** The work panel is open beside the thread, so its toggle shows as on. */
  panel?: boolean;
  /** The work column's tabs, when more than this thread's own is open or its tab has more to say. */
  tabs?: Tab[];
  /** The pane is split beside the first. */
  split?: boolean;
}
const { id, title, busy, panel, tabs = [{ label: title, current: true, busy }], split, ...body } = Astro.props;
const { journey } = body;
---

<section class="hs-pane" data-pane={id} {...(busy && journey ? flagged(journey, { busy }) : {})}>
  <ThreadHeader journey={journey} tabs={split ? undefined : tabs} title={split ? title : undefined} panel={panel} />
  <ThreadBody {...body}><slot /></ThreadBody>
</section>
