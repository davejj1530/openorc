---
/**
 * Across threads. Both threads are working. Asked to build the billing page,
 * Claude Code sees that the Plans migration thread is changing the data it
 * needs and asks it with thread_send; the question joins that thread's running
 * turn as a message notice, Codex answers the same way from its unmerged work
 * and goes back to the migration, and the answer starts a new turn that builds
 * the page against the new shape. Each turn shows its work as the app writes it
 * while it runs, a step a line and a line for each thing the step did, then
 * folds behind its receipt. Content and timing: data/hero/handoff.ts. With
 * motion, blocks open with springs and each message flies to the thread it
 * reaches, opening into that thread's notice.
 */
import ChangeLine from "./ChangeLine.astro";
import Notice from "./Notice.astro";
import ProductIcon from "./ProductIcon.astro";
import Prose from "./Prose.astro";
import Receipt from "./Receipt.astro";
import SceneFrame from "./SceneFrame.astro";
import ThreadPane from "./ThreadPane.astro";
import TurnEnd from "./TurnEnd.astro";
import Work from "./Work.astro";
import WorkAct from "./WorkAct.astro";
import WorkLine from "./WorkLine.astro";
import { busy, handoff, threads } from "../../data/hero/handoff";
import { timed } from "../../data/hero/timeline";
import { branches } from "../../data/hero/workspace";

interface Props {
  label: string;
}
const { label } = Astro.props;
const { a, b } = threads;
const rows = [
  { id: "a", title: a.title, busy: busy.a },
  { id: "b", title: b.title, branch: branches.plansThread, busy: busy.b },
];
const at = (windows: string) => timed(handoff, windows);
const head = { journey: handoff };
const name = (path: string) => path.slice(path.lastIndexOf("/") + 1);
/** A line's verb while its thing is under way, then once it is done. */
const verbs = (during: string, after: string, done: string) => [
  { text: during, show: `<${done}` },
  { text: after, show: `>${done}` },
];
const [migrating] = b.edits.slice(-1);
---

<SceneFrame id="handoff" journey={handoff} label={label} rows={rows} motion>
  <div class="hs-panes" data-split>
    <ThreadPane
      id="a"
      journey={handoff}
      title={a.title}
      busy={busy.a}
      more
      model={{ harness: a.harness, label: a.label, effort: a.effort }}
      permission={a.permission}
      placeholder={`Message ${a.agent}…`}
      changes=">aFinish"
      changeStat={a.change}
      prompt={{ text: a.prompt, typo: a.typo, window: "typeStart~typeEnd", typed: "typeStart~aSend" }}
    >
      <div class="hs-turn">
        <div class="hs-user"><div class="hs-bubble">{a.earlier.request}</div></div>
        <Receipt {...a.earlier.receipt} />
        <div class="hs-reply"><Prose text={a.earlier.reply} /></div>
        <TurnEnd took={a.earlier.took} />
      </div>

      <!-- First turn: read the settings pages, then ask the migration thread before building. -->
      <div class="hs-turn" data-grow {...at(">aSend")}>
        <div class="hs-user"><div class="hs-bubble">{a.prompt}</div></div>
        <Receipt
          {...head}
          thought={[
            { text: "Thinking", show: "<aThought" },
            { text: "Thought 1s", show: ">aThought" },
          ]}
          steps={[
            { text: "1 step", show: "aThought~aSending" },
            { text: "2 steps", show: ">aSending" },
          ]}
        />
        <Work grow {...at("aSend~aDone")}>
          <WorkLine {...head} title={[{ text: a.phases.read, show: ">aThought" }]} running="<aRead">
            <WorkAct {...head} grow {...at("<aThought")} live icon="lightbulb" name="Thinking" />
            <WorkAct {...head} grow {...at(">aThought")} file="src/settings/Settings.tsx" verb={verbs("Reading", "Read", "aRead")} name="Settings.tsx, Members.tsx and 2 more" running="<aRead" />
          </WorkLine>
          <WorkLine {...head} grow data-anchor="a-sending" {...at(">aSending")} title={a.phases.ask} running="<aAskedStart">
            <WorkAct {...head} icon="workMessage" verb={verbs("Sending message", "Sent message", "aSent")} name={a.flight} running="<aSent" />
          </WorkLine>
        </Work>
        <div class="hs-reply" data-grow {...at(">aAskedStart")}><Prose text={a.asked} stream="aAskedStart~aAskedEnd" /></div>
        <TurnEnd {...head} clock={{ from: "aSend", writing: "aAskedStart", to: "aDone" }} />
      </div>

      <!-- The answer starts a new turn that builds the page against the new shape; the notice opens it. -->
      <div class="hs-turn" data-grow {...at(">bSent")}>
        <Notice data-anchor="a-notice" from={a.notice.from} text={a.notice.text} />
        <Receipt
          {...head}
          grow
          {...at(">aWork")}
          steps={[{ text: "1 step", show: "<aEdited" }]}
          changes={[{ text: `+${a.change.added} in 1 file`, show: ">aEdited" }]}
        />
        <Work grow {...at("aWork~aFinish")} journey={handoff} timeline=">aEdited">
          <WorkLine {...head} title={a.phases.build} running="<aEdited">
            <WorkAct {...head} file={a.change.path} verb={verbs("Writing", "Wrote", "aEdited")} name={name(a.change.path)} added={a.change.added} removed={a.change.removed} created settled=">aEdited" running="<aEdited" />
          </WorkLine>
        </Work>
        <div class="hs-reply" data-grow {...at(">aResultStart")}>
          <Prose text={a.result} stream="aResultStart~aResultEnd" proof={{ text: `${name(a.change.path)} +${a.change.added}`, show: at(">aFinish") }} />
        </div>
        <ChangeLine grow {...at(">aFinish")} files={1} added={a.change.added} removed={a.change.removed} undo />
        <TurnEnd {...head} data-grow="" {...at(">aWork")} clock={{ from: "aWork", writing: "aResultStart", to: "aFinish" }} />
      </div>
    </ThreadPane>

    <ThreadPane id="b" split journey={handoff} title={b.title} busy={busy.b} model={{ harness: b.harness, label: b.label, effort: b.effort }} permission={b.permission} placeholder={`Message ${b.agent}…`} changes changeStat={b.change}>
      <!-- Mid-migration when the scene opens: the message joins this turn, so its work keeps going. -->
      <div class="hs-turn">
        <div class="hs-user"><div class="hs-bubble">{b.request}</div></div>
        <Receipt
          {...head}
          thought="Thought 6s"
          changes={[
            { text: "+30 −17 in 2 files", show: "<aSent" },
            { text: `+${b.change.added} −${b.change.removed} in 3 files`, show: ">aSent" },
          ]}
        />
        <Work timeline>
          <WorkLine title={b.phases.read}>
            <WorkAct file="src/db/plans.ts" verb="Read" name="plans.ts, users.ts and 4 more" />
            <WorkAct icon="search" verb="Searched" name="“user.plan”, “planId”" result="2 searches" />
          </WorkLine>
          <WorkLine {...head} title={b.phases.migrate} running="<aSent">
            {b.edits.slice(0, -1).map((edit, index) => (
              <WorkAct file={edit.path} verb={index ? "Edited" : "Wrote"} name={name(edit.path)} added={edit.added} removed={edit.removed} created={!index} />
            ))}
            {migrating ? <WorkAct {...head} file={migrating.path} verb={verbs("Writing", "Wrote", "aSent")} name={name(migrating.path)} added={migrating.added} created settled=">aSent" running="<aSent" /> : null}
          </WorkLine>
          <WorkLine {...head} grow data-anchor="b-sending" {...at(">bWork")} title={b.phases.answer} running="<bAnswerStart">
            <WorkAct {...head} grow {...at("<bSending")} live icon="lightbulb" name="Thinking" />
            <WorkAct {...head} grow {...at(">bSending")} icon="workMessage" verb={verbs("Sending message", "Sent message", "bSent")} name={b.flight} running="<bSent" />
          </WorkLine>
          <WorkLine {...head} grow {...at(">bAnswerStart")}>
            <div slot="head" class="hs-work-said"><Prose text={b.answer} stream="bAnswerStart~bAnswerEnd" /></div>
          </WorkLine>
          <WorkLine {...head} grow {...at(">bDone")} title={b.phases.resume} running=">bDone">
            <WorkAct {...head} file="src/billing/queries.ts" verb="Editing" name="queries.ts" running=">bDone" />
          </WorkLine>
        </Work>
        <Notice grow data-anchor="b-notice" {...at(">aSent")} from={b.notice.from} text={b.notice.text} />
        <TurnEnd {...head} clock={{ from: "bStart" }} />
      </div>
    </ThreadPane>
  </div>
  <div class="hs-flight" data-from="a-sending" data-to="b-notice" data-start="aSending" data-land="aLand" aria-hidden="true" hidden><ProductIcon name="workMessage" /><span class="hs-flight-label">{a.flight}</span></div>
  <div class="hs-flight" data-from="b-sending" data-to="a-notice" data-start="bSending" data-land="bLand" aria-hidden="true" hidden><ProductIcon name="workMessage" /><span class="hs-flight-label">{b.flight}</span></div>
</SceneFrame>
