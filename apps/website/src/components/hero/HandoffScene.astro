---
/**
 * Across threads. Both threads are working. Asked to build the billing page,
 * Claude Code sees that the Plans migration thread is changing the data it
 * needs and asks it with thread_send; the question joins that thread's running
 * turn as a message notice, Codex answers the same way from its unmerged work
 * and goes back to the migration, and the page is built against the new shape.
 * Content and timing: data/hero/handoff.ts.
 * With motion, blocks open with springs and each message flies to the thread
 * it reaches, opening into that thread's notice.
 */
import { Image } from "astro:assets";
import mark from "../../assets/openorc-mark.png";
import ProductIcon from "./ProductIcon.astro";
import Prose from "./Prose.astro";
import SceneFrame from "./SceneFrame.astro";
import ThreadPane from "./ThreadPane.astro";
import { busy, handoff, threads } from "../../data/hero/handoff";
import { timed } from "../../data/hero/timeline";
import { branches } from "../../data/hero/workspace";

interface Props {
  label: string;
}
const { label } = Astro.props;
const { a, b } = threads;
const rows = [
  { id: "a", title: a.title, providers: [{ harness: a.harness, label: a.agent }], busy: busy.a },
  { id: "b", title: b.title, branch: branches.plansThread, providers: [{ harness: b.harness, label: b.agent }], busy: busy.b },
];
const at = (windows: string) => timed(handoff, windows);
---

<SceneFrame id="handoff" journey={handoff} label={label} view="a" rows={rows} motion>
  <div class="hs-panes" data-split>
    <ThreadPane
      id="a"
      journey={handoff}
      title={a.title}
      busy={busy.a}
      model={{ harness: a.harness, label: a.label, effort: a.effort }}
      permission={a.permission}
      placeholder={`Message ${a.agent}…`}
      changes=">aFinish"
      changeStat={a.change}
      prompt={{ text: a.prompt, typo: a.typo, window: "typeStart~typeEnd", typed: "typeStart~aSend" }}
    >
      <div class="hs-user"><div class="hs-bubble">{a.earlier.request}</div></div>
      <div class="hs-work"><span class="hs-work-toggle">{a.earlier.worked}<ProductIcon name="chevronRight" /></span></div>
      <div class="hs-reply"><Prose text={a.earlier.reply} /></div>

      <div class="hs-user hs-block" data-grow {...at(">aSend")}><div class="hs-bubble">{a.prompt}</div></div>
      <div class="hs-work hs-block" data-grow {...at(">aSend")}>
        <span class="hs-work-toggle" data-open {...at("aSend~aDone")}><span data-clock="aSend">Working · 0s</span><ProductIcon name="chevronRight" /></span>
        <span class="hs-work-toggle" {...at(">aDone")}><span data-duration="aSend~aDone">Worked for 4s</span><ProductIcon name="chevronRight" /></span>
        <div class="hs-work-content" data-grow {...at("aSend~aDone")}>
          <span class="hs-step" {...at("aSend~aThought")}><ProductIcon name="message" />Thinking<i class="hs-pulse"></i></span>
          <span class="hs-step" {...at("aThought~aDone")}><ProductIcon name="message" />Thought for 1s</span>
          <span class="hs-step-slot hs-block" data-grow {...at("aThought~aDone")}>
            <span class="hs-step hs-group-step" {...at("aThought~aRead")}><ProductIcon name="live" class="hs-live" />Reading files<ProductIcon name="chevronRight" /></span>
            <span class="hs-step hs-group-step" {...at("aRead~aDone")}><ProductIcon name="read" />Read 4 files<ProductIcon name="chevronRight" /></span>
          </span>
          <span class="hs-step-slot hs-block" data-grow data-anchor="a-sending" {...at("aSending~aDone")}>
            <span class="hs-step" {...at("aSending~aSent")}><ProductIcon name="message" />Sending message<i class="hs-pulse"></i></span>
            <span class="hs-step" {...at("aSent~aDone")}><ProductIcon name="message" />Sent message</span>
          </span>
        </div>
      </div>
      <div class="hs-reply hs-block" data-grow {...at(">aAskedStart")}><Prose text={a.asked} stream="aAskedStart~aAskedEnd" /></div>

      <div class="hs-work hs-block" data-grow {...at(">aWork")}>
        <span class="hs-work-toggle" data-open {...at("aWork~aFinish")}><span data-clock="bSent">Working · 0s</span><ProductIcon name="chevronRight" /></span>
        <span class="hs-work-toggle" {...at(">aFinish")}><span data-duration="bSent~aFinish">Worked for 6s</span><ProductIcon name="chevronRight" /></span>
        <div class="hs-work-content" data-grow {...at("aWork~aFinish")}>
          <span class="hs-step hs-group-step" {...at("aWork~aEdited")}><ProductIcon name="live" class="hs-live" />Editing files<ProductIcon name="chevronRight" /></span>
          <span class="hs-step hs-group-step" {...at("aEdited~aFinish")}><ProductIcon name="edit" />Edited a file<ProductIcon name="chevronRight" /></span>
        </div>
      </div>
      <div class="hs-notice hs-block" data-grow data-anchor="a-notice" {...at(">bSent")}>
        <ProductIcon name="message" />
        <span class="hs-notice-body">
          <span class="hs-notice-head">{a.notice.head}</span>
          <span class="hs-notice-toggle">Show details</span>
        </span>
      </div>
      <div class="hs-reply hs-block" data-grow {...at(">aResultStart")}><Prose text={a.result} stream="aResultStart~aResultEnd" /></div>
      <section class="hs-change hs-block" data-grow {...at(">aFinish")}>
        <div class="hs-change-heading">
          <span class="hs-change-icon"><ProductIcon name="pencil" /></span>
          <span class="hs-change-title">
            <span class="hs-change-summary">Edited 1 file</span>
            <span class="hs-counts"><span class="hs-added">+{a.change.added}</span><span class="hs-removed">−{a.change.removed}</span></span>
          </span>
          <span class="hs-change-actions">
            <span class="hs-button hs-button-ghost"><ProductIcon name="undo" />Undo</span>
            <span class="hs-button">Review</span>
          </span>
        </div>
        <div class="hs-change-file">
          <span>{a.change.path.slice(0, a.change.path.lastIndexOf("/") + 1)}<span class="hs-file-name">{a.change.path.slice(a.change.path.lastIndexOf("/") + 1)}</span></span>
          <span class="hs-counts"><span class="hs-added">+{a.change.added}</span><span class="hs-removed">−{a.change.removed}</span></span>
        </div>
      </section>
      <div class="hs-presence"><span class="hs-orb"><Image src={mark} alt="" width={48} height={48} format="webp" loading="eager" /></span></div>
    </ThreadPane>

    <ThreadPane id="b" journey={handoff} title={b.title} busy={busy.b} model={{ harness: b.harness, label: b.label, effort: b.effort }} permission={b.permission} placeholder={`Message ${b.agent}…`} worktree branch={branches.plansThread}>
      <div class="hs-user"><div class="hs-bubble">{b.request}</div></div>
      <!-- Mid-migration when the scene opens: the message joins this turn. -->
      <div class="hs-work">
        <span class="hs-work-toggle" data-open {...at("<aSent")}><span data-clock="bStart">Working · 0s</span><ProductIcon name="chevronRight" /></span>
        <span class="hs-work-toggle hs-block" {...at(">aSent")}><span data-duration="bStart~aSent">Worked for 44s</span><ProductIcon name="chevronRight" /></span>
        <div class="hs-work-content" data-grow {...at("<aSent")}>
          <span class="hs-step hs-group-step"><ProductIcon name="read" />Read 6 files<ProductIcon name="chevronRight" /></span>
          <span class="hs-step hs-group-step"><ProductIcon name="edit" />Edited 3 files<ProductIcon name="chevronRight" /></span>
          <span class="hs-step hs-group-step"><ProductIcon name="live" class="hs-live" />Editing files<ProductIcon name="chevronRight" /></span>
        </div>
      </div>
      <div class="hs-notice hs-block" data-grow data-anchor="b-notice" {...at(">aSent")}>
        <ProductIcon name="message" />
        <span class="hs-notice-body">
          <span class="hs-notice-head">{b.notice.head}</span>
          <span class="hs-notice-details" {...at(">bDetails")}>{b.notice.details}</span>
          <span class="hs-notice-toggle" {...at("<bDetails")}>Show details</span>
          <span class="hs-notice-toggle" {...at(">bDetails")}>Hide details</span>
        </span>
      </div>
      <div class="hs-work hs-block" data-grow {...at(">bWork")}>
        <span class="hs-work-toggle" data-open {...at("bWork~bAnswerStart")}><span data-clock="bWork">Working · 0s</span><ProductIcon name="chevronRight" /></span>
        <span class="hs-work-toggle" {...at(">bAnswerStart")}><span data-duration="bWork~bAnswerStart">Worked for 3s</span><ProductIcon name="chevronRight" /></span>
        <div class="hs-work-content" data-grow {...at("bWork~bAnswerStart")}>
          <span class="hs-step" {...at("bWork~bThought")}><ProductIcon name="message" />Thinking<i class="hs-pulse"></i></span>
          <span class="hs-step" {...at("bThought~bAnswerStart")}><ProductIcon name="message" />Thought for 1s</span>
          <span class="hs-step-slot hs-block" data-grow data-anchor="b-sending" {...at("bSending~bAnswerStart")}>
            <span class="hs-step" {...at("bSending~bSent")}><ProductIcon name="message" />Sending message<i class="hs-pulse"></i></span>
            <span class="hs-step" {...at("bSent~bAnswerStart")}><ProductIcon name="message" />Sent message</span>
          </span>
        </div>
      </div>
      <div class="hs-reply hs-block" data-grow {...at(">bAnswerStart")}><Prose text={b.answer} stream="bAnswerStart~bAnswerEnd" /></div>
      <!-- Then back to the migration, still working when the scene ends. -->
      <div class="hs-work hs-block" data-grow {...at(">bDone")}>
        <span class="hs-work-toggle" data-open><span data-clock="bDone">Working · 0s</span><ProductIcon name="chevronRight" /></span>
        <div class="hs-work-content">
          <span class="hs-step hs-group-step"><ProductIcon name="live" class="hs-live" />Editing files<ProductIcon name="chevronRight" /></span>
        </div>
      </div>
      <div class="hs-presence"><span class="hs-orb"><Image src={mark} alt="" width={48} height={48} format="webp" loading="eager" /></span></div>
    </ThreadPane>
  </div>
  <div class="hs-flight" data-from="a-sending" data-to="b-notice" data-start="aSending" data-land="aLand" aria-hidden="true" hidden><ProductIcon name="message" /><span class="hs-flight-label">{a.flight}</span></div>
  <div class="hs-flight" data-from="b-sending" data-to="a-notice" data-start="bSending" data-land="bLand" aria-hidden="true" hidden><ProductIcon name="message" /><span class="hs-flight-label">{b.flight}</span></div>
</SceneFrame>
