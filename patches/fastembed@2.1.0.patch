+    return JSON.parse(fs.readFileSync(file, "utf8"));
+  };
+  const source = read("tokenizer.json");
+  const config = read("config.json");
+  const options = read("tokenizer_config.json");
+  const specialTokens = read("special_tokens_map.json");
+  if (config._name_or_path !== "sentence-transformers/all-MiniLM-L6-v2" ||
+      source.model?.type !== "WordPiece" || source.post_processor?.type !== "TemplateProcessing" ||
+      source.normalizer?.type !== "BertNormalizer" || source.pre_tokenizer?.type !== "BertPreTokenizer") {
+    throw new Error("OpenOrc's FastEmbed patch supports only the reviewed MiniLM WordPiece configuration");
+  }
+  const sequence = source.post_processor.single.filter((item) => item.Sequence);
+  if (sequence.length !== 1 || sequence[0].Sequence.id !== "A") {
+    throw new Error("Unsupported MiniLM single-sequence template");
+  }
+  for (const value of Object.values(specialTokens)) {
+    const content = typeof value === "string" ? value : value.content;
+    const added = source.added_tokens.find((token) => token.content === content && token.special);
+    if (!added || (typeof value === "object" && ["single_word", "lstrip", "rstrip", "normalized"].some((key) => value[key] !== added[key]))) {
+      throw new Error("MiniLM special-token map disagrees with the tokenizer");
