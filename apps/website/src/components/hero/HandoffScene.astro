---
/**
 * Across threads. Both threads are working. Asked to build the billing page,
 * Claude Code sees that the Plans migration thread is changing the data it
 * needs and asks it with thread_send; the question joins that thread's running
 * turn as a message notice, Codex answers the same way from its unmerged work
 * and goes back to the migration, and the page is built against the new shape.
 * The transcripts follow the app's work steps: a rail of phases while a turn
 * runs, then one receipt line above the reply. Content and timing: data/hero/handoff.ts.
 * With motion, blocks open with springs and each message flies to the thread
 * it reaches, opening into that thread's notice.
 */
import ProductIcon from "./ProductIcon.astro";
import Prose from "./Prose.astro";
import SceneFrame from "./SceneFrame.astro";
import ThreadPane from "./ThreadPane.astro";
import { busy, handoff, threads } from "../../data/hero/handoff";
import { timed } from "../../data/hero/timeline";
import { branches } from "../../data/hero/workspace";

interface Props {
  label: string;
}
const { label } = Astro.props;
const { a, b } = threads;
const rows = [
  { id: "a", title: a.title, providers: [{ harness: a.harness, label: a.agent }], busy: busy.a, headline: a.headline },
  { id: "b", title: b.title, branch: branches.plansThread, providers: [{ harness: b.harness, label: b.agent }], busy: busy.b, headline: b.headline },
];
const at = (windows: string) => timed(handoff, windows);
const file = (path: string) => path.slice(path.lastIndexOf("/") + 1);
---

<SceneFrame id="handoff" journey={handoff} label={label} view="a" rows={rows} motion>
  <div class="hs-panes" data-split>
    <ThreadPane
      id="a"
      journey={handoff}
      title={a.title}
      busy={busy.a}
      model={{ harness: a.harness, label: a.label, effort: a.effort }}
      permission={a.permission}
      placeholder={`Message ${a.agent}…`}
      changes=">aFinish"
      changeStat={a.change}
      prompt={{ text: a.prompt, typo: a.typo, window: "typeStart~typeEnd", typed: "typeStart~aSend" }}
    >
      <div class="hs-user"><div class="hs-bubble">{a.earlier.request}</div></div>
      <div class="hs-work"><span class="hs-work-toggle">{a.earlier.worked}<ProductIcon name="chevronRight" /></span></div>
      <div class="hs-reply"><div class="hs-author">Assistant</div><Prose text={a.earlier.reply} /></div>

      <div class="hs-user hs-block" data-grow {...at(">aSend")}><div class="hs-bubble">{a.prompt}</div></div>
      <!-- First turn: read the settings pages, then ask the migration thread before building. -->
      <div class="hs-work hs-block" data-grow {...at(">aSend")}>
        <span class="hs-work-toggle" {...at("aSend~aDone")}><span data-clock="aSend">Working · 0s</span><ProductIcon name="chevronDown" /></span>
        <span class="hs-work-toggle" {...at(">aDone")}><span data-duration="aSend~aDone">Worked for 5s</span><ProductIcon name="chevronRight" /></span>
        <div class="hs-work-content" data-grow {...at("aSend~aDone")}>
          <ol class="hs-rail">
            <li class="hs-rail-item">
              <span class="hs-rail-dot"><span class="hs-live-dot" {...at("aSend~aRead")}></span><span class="hs-done" {...at(">aRead")}><ProductIcon name="check" /></span></span>
              <span class="hs-rail-line">
                <span class="hs-rail-title" {...at("aSend~aThought")}>Thinking</span>
                <span class="hs-rail-title" {...at(">aThought")}>{a.phases.read}</span>
                <span class="hs-rail-meta" {...at(">aRead")}>4 files</span>
              </span>
            </li>
            <li class="hs-rail-item hs-block" data-grow data-anchor="a-sending" {...at(">aSending")}>
              <span class="hs-rail-dot"><span class="hs-live-dot" {...at("aSending~aSent")}></span><span class="hs-done" {...at(">aSent")}><ProductIcon name="check" /></span></span>
              <span class="hs-rail-line"><span class="hs-rail-title">{a.phases.ask}</span></span>
              <div class="hs-rail-body">
                <span class="hs-rail-note"><ProductIcon name="workMessage" /><span {...at("aSending~aSent")}>Sending message</span><span {...at(">aSent")}>Sent message</span></span>
              </div>
            </li>
          </ol>
        </div>
      </div>
      <div class="hs-reply hs-block" data-grow {...at(">aAskedStart")}><div class="hs-author">Assistant</div><Prose text={a.asked} stream="aAskedStart~aAskedEnd" /></div>

      <div class="hs-notice hs-block" data-grow data-anchor="a-notice" {...at(">bSent")}>
        <ProductIcon name="workMessage" />
        <span class="hs-notice-body">
          <span class="hs-notice-head">{a.notice.head}</span>
          <span class="hs-notice-toggle">Show details</span>
        </span>
      </div>
      <!-- The answer starts a new turn: build the page against the new shape. -->
      <div class="hs-work hs-block" data-grow {...at(">aWork")}>
        <span class="hs-work-toggle" {...at("aWork~aFinish")}><span data-clock="bSent">Working · 0s</span><ProductIcon name="chevronDown" /></span>
        <span class="hs-work-toggle" {...at(">aFinish")}>{a.receipt}<ProductIcon name="chevronRight" /></span>
        <div class="hs-work-content" data-grow {...at("aWork~aFinish")}>
          <ol class="hs-rail">
            <li class="hs-rail-item">
              <span class="hs-rail-dot"><span class="hs-live-dot" {...at("aWork~aEdited")}></span><span class="hs-done" {...at(">aEdited")}><ProductIcon name="check" /></span></span>
              <span class="hs-rail-line"><span class="hs-rail-title">{a.phases.build}</span><span class="hs-rail-meta" {...at(">aEdited")}>1 file changed</span></span>
              <div class="hs-rail-body" {...at("aWork~aEdited")}>
                <div>
                  <span class="hs-rail-label">Editing</span>
                  <div class="hs-chips">
                    <span class="hs-file-chip" data-live><ProductIcon name="fileCode" />{file(a.change.path)}<span class="hs-added">+{a.change.added}</span></span>
                  </div>
                </div>
              </div>
            </li>
          </ol>
        </div>
      </div>
      <div class="hs-reply hs-block" data-grow {...at(">aResultStart")}><div class="hs-author">Assistant</div><Prose text={a.result} stream="aResultStart~aResultEnd" /></div>
      <section class="hs-change hs-block" data-grow {...at(">aFinish")}>
        <div class="hs-change-heading">
          <span class="hs-change-icon"><ProductIcon name="pencil" /></span>
          <span class="hs-change-title">
            <span class="hs-change-summary">Edited 1 file</span>
            <span class="hs-counts"><span class="hs-added">+{a.change.added}</span><span class="hs-removed">−{a.change.removed}</span></span>
          </span>
          <span class="hs-change-actions">
            <span class="hs-button hs-button-ghost">Undo<ProductIcon name="undo" /></span>
            <span class="hs-button">Review</span>
          </span>
        </div>
        <div class="hs-change-file">
          <span>{a.change.path.slice(0, a.change.path.lastIndexOf("/") + 1)}<span class="hs-file-name">{file(a.change.path)}</span></span>
          <span class="hs-counts"><span class="hs-added">+{a.change.added}</span><span class="hs-removed">−{a.change.removed}</span></span>
        </div>
      </section>
    </ThreadPane>

    <ThreadPane id="b" journey={handoff} title={b.title} busy={busy.b} model={{ harness: b.harness, label: b.label, effort: b.effort }} permission={b.permission} placeholder={`Message ${b.agent}…`} branch={branches.plansThread} changes changeStat={b.change}>
      <div class="hs-user"><div class="hs-bubble">{b.request}</div></div>
      <!-- Mid-migration when the scene opens: the message joins this turn, so its rail keeps going. -->
      <div class="hs-work">
        <span class="hs-work-toggle"><span data-clock="bStart">Working · 0s</span><ProductIcon name="chevronDown" /></span>
        <div class="hs-work-content">
          <ol class="hs-rail">
            <li class="hs-rail-item">
              <span class="hs-rail-dot"><span class="hs-done"><ProductIcon name="check" /></span></span>
              <span class="hs-rail-line"><span class="hs-rail-title">{b.phases.read}</span><span class="hs-rail-meta">6 files · 2 searches</span></span>
            </li>
            <li class="hs-rail-item">
              <span class="hs-rail-dot"><span class="hs-live-dot" {...at("<aSent")}></span><span class="hs-done" {...at(">aSent")}><ProductIcon name="check" /></span></span>
              <span class="hs-rail-line"><span class="hs-rail-title">{b.phases.migrate}</span><span class="hs-rail-meta" {...at(">aSent")}>3 files changed</span></span>
              <div class="hs-rail-body" {...at("<aSent")}>
                <div>
                  <span class="hs-rail-label">Edited<span class="hs-rail-count">2</span></span>
                  <div class="hs-chips">
                    {b.edited.map((path) => <span class="hs-file-chip"><ProductIcon name="fileCode" />{file(path)}</span>)}
                  </div>
                </div>
                <div>
                  <span class="hs-rail-label">Editing</span>
                  <div class="hs-chips"><span class="hs-file-chip" data-live><ProductIcon name="fileCode" />{file(b.editing)}</span></div>
                </div>
              </div>
            </li>
            <li class="hs-rail-item hs-block" data-grow data-anchor="b-sending" {...at(">bWork")}>
              <span class="hs-rail-dot"><span class="hs-live-dot" {...at("bWork~bSent")}></span><span class="hs-done" {...at(">bSent")}><ProductIcon name="check" /></span></span>
              <span class="hs-rail-line"><span class="hs-rail-title">{b.phases.answer}</span></span>
              <div class="hs-rail-body">
                <div class="hs-rail-narration hs-block" data-grow {...at(">bAnswerStart")}><Prose text={b.answer} stream="bAnswerStart~bAnswerEnd" /></div>
                <span class="hs-rail-note" {...at(">bSending")}><ProductIcon name="workMessage" /><span {...at("bSending~bSent")}>Sending message</span><span {...at(">bSent")}>Sent message</span></span>
              </div>
            </li>
            <li class="hs-rail-item hs-block" data-grow {...at(">bDone")}>
              <span class="hs-rail-dot"><span class="hs-live-dot"></span></span>
              <span class="hs-rail-line"><span class="hs-rail-title">{b.phases.resume}</span><span class="hs-rail-elapsed" data-clock="bDone" data-clock-text="{s}s">0s</span></span>
            </li>
          </ol>
        </div>
      </div>
      <div class="hs-notice hs-block" data-grow data-anchor="b-notice" {...at(">aSent")}>
        <ProductIcon name="workMessage" />
        <span class="hs-notice-body">
          <span class="hs-notice-head">{b.notice.head}</span>
          <span class="hs-notice-details" {...at(">bDetails")}>{b.notice.details}</span>
          <span class="hs-notice-toggle" {...at("<bDetails")}>Show details</span>
          <span class="hs-notice-toggle" {...at(">bDetails")}>Hide details</span>
        </span>
      </div>
    </ThreadPane>
  </div>
  <div class="hs-flight" data-from="a-sending" data-to="b-notice" data-start="aSending" data-land="aLand" aria-hidden="true" hidden><ProductIcon name="workMessage" /><span class="hs-flight-label">{a.flight}</span></div>
  <div class="hs-flight" data-from="b-sending" data-to="a-notice" data-start="bSending" data-land="bLand" aria-hidden="true" hidden><ProductIcon name="workMessage" /><span class="hs-flight-label">{b.flight}</span></div>
</SceneFrame>
