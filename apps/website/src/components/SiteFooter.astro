---
import BrandMark from "./BrandMark.astro";
import { getPublishedReleases } from "../data/changelog";
const hasPublishedReleases = (await getPublishedReleases()).length > 0;
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a class="wordmark" href="/">
        <BrandMark />
        OpenOrc
      </a>
      <p class="footer-credit">Made by <a href="https://www.eliasdavidceriola.com/">David Ceriola</a></p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <div>
        <h2>Product</h2>
        <a href="/download/">Downloads</a>
        {hasPublishedReleases && <a href="/changelog/">Changelog</a>}
      </div>
      <div>
        <h2>Resources</h2>
        <a href="/docs/">Docs</a>
        <a href="https://github.com/davejj1530/openorc" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
      <div>
        <h2>Legal</h2>
        <a href="/privacy/">Privacy</a>
      </div>
    </nav>
  </div>
</footer>
