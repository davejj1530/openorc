{
  "expo": {
    "name": "OpenOrc",
    "slug": "openorc",
    "owner": "david1530",
    "scheme": "openorc",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/OpenOrc.icon",
      "bundleIdentifier": "app.openorc.mobile",
      "appleTeamId": "8VR6L6XPS9",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "OpenOrc connects to your Mac on this network."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/ImmaculateGothic-Text.ttf", "./assets/fonts/ImmaculateGothic-Bold.ttf", "./node_modules/@expo-google-fonts/jetbrains-mono/400Regular/JetBrainsMono_400Regular.ttf"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OpenOrc uses the camera to scan the pairing code on your Mac and to take photos you attach.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OpenOrc attaches the photos you choose to your messages.",
          "cameraPermission": "OpenOrc uses the camera to scan the pairing code on your Mac and to take photos you attach.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "react-native-quick-crypto",
      [
        "expo-notifications",
        {
          "mode": "development"
        }
      ],
      "@bacons/apple-targets",
      "./plugins/strip-after-info-plist"
    ],
    "extra": {
      "eas": {
        "projectId": "ea45e9f0-4deb-4a44-b2fb-c81b5951200c"
      }
    }
  }
}
