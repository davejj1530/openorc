---
/** It waits on the person's answer, as the app's AskMark draws it: a solid disc with a question cut out. */
import { svgId } from "../../lib/svg-id";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const mask = svgId("hs-ask");
---

<svg class:list={["hs-ask-mark", className]} viewBox="0 0 16 16" aria-hidden="true">
  <mask id={mask}>
    <rect width="16" height="16" fill="#000" />
    <circle cx="8" cy="8" r="7" fill="#fff" />
    <path d="M6.1 6.3a1.95 1.95 0 1 1 3.1 1.6c-.7.5-1.2.9-1.2 1.7 M8 11.7v.05" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </mask>
  <rect width="16" height="16" fill="currentColor" mask={`url(#${mask})`} />
</svg>
