<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 compiles JavaScript at run time. Every native library OpenOrc loads (node-pty, sqlite-vec, onnxruntime,
       the speech library and its binding) sits outside app.asar and is signed with the app, so library validation
       stays on. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Dictation records the microphone, after macOS asks the person. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
