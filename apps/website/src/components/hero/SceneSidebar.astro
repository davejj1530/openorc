---
/**
 * The app sidebar as the desktop app lays it out (Sidebar.tsx): Inbox, search and the sidebar toggle by the window
 * controls; New thread, Tasks, Schedules and More; the Threads and Orclings track with its search and filter; then
 * projects with their threads. A working thread has a spinner before its title and says what its agent is doing
 * under it, and its project counts the threads running. Add project, the week's usage and Settings sit at the foot.
 * Stills pass no journey.
 */
import ProductIcon, { type IconName } from "./ProductIcon.astro";
import { otherThreads, project, type SidebarRow } from "../../data/hero/workspace";
import { flagged, timed, type Journey } from "../../data/hero/timeline";

interface Props {
  /** The scene's journey; stills pass none. */
  journey?: Journey;
  /** Navigation row shown as the current view, if the scene is not a thread. */
  nav?: "Tasks";
  /** Threads listed under the studio project ahead of the shared ones. */
  rows: SidebarRow[];
  /** Window during which an agent's question waits in the Inbox. */
  inboxPending?: string;
}
const { journey, nav, rows, inboxPending } = Astro.props;
const navigation: { icon: IconName; label: string; count?: number }[] = [
  { icon: "compose", label: "New thread" },
  { icon: "tasks", label: "Tasks", count: 3 },
  { icon: "scheduled", label: "Schedules", count: 2 },
];
const studio = [...rows, ...otherThreads.filter((thread) => !rows.some((row) => row.title === thread.title))];
const show = (windows: string) => (journey ? timed(journey, windows) : {});
/** A row is busy, or waits on the user, for a scene's windows; a still's busy row always works. */
const stateAttributes = ({ busy, waiting }: SidebarRow) => {
  if (busy === true) return { "data-busy": "" };
  const flags = Object.fromEntries(Object.entries({ busy, waiting }).filter((entry): entry is [string, string] => typeof entry[1] === "string"));
  return journey && Object.keys(flags).length ? flagged(journey, flags) : {};
};
// The project says when one of its threads needs you, or counts those running; scenes run at most two at once.
const running = Math.min(2, studio.filter((row) => row.busy).length);
const needs = studio.some((row) => row.waiting);
const inbox = 2;
const [pendingFrom, pendingTo] = inboxPending?.split("~") ?? [];
const usage = 64;
---

<aside class="hs-sidebar">
  <div class="hs-sidebar-head">
    <span class="hs-round hs-inbox">
      <ProductIcon name="inbox" />
      <span class="hs-inbox-count">
        {inboxPending ? <span {...show(`<${pendingFrom} >${pendingTo}`)}>{inbox}</span> : inbox}
        {inboxPending ? <span {...show(inboxPending)}>{inbox + 1}</span> : null}
      </span>
    </span>
    <span class="hs-round"><ProductIcon name="search" /></span>
    <span class="hs-round"><ProductIcon name="panelLeft" /></span>
  </div>
  <nav class="hs-nav">
    {navigation.map((item) => (
      <span class="hs-nav-row" data-nav={item.label} data-current={item.label === nav ? "" : undefined}>
        <ProductIcon name={item.icon} />
        <span class="hs-nav-label">{item.label}</span>
        {item.count ? <span class="hs-nav-count">{item.count}</span> : null}
      </span>
    ))}
    <span class="hs-nav-row">
      <ProductIcon name="more" />
      <span class="hs-nav-label">More</span>
      <ProductIcon name="chevronDown" class="hs-nav-chevron" />
    </span>
  </nav>
  <div class="hs-list-head">
    <span class="hs-track"><span data-selected>Threads</span><span>Orclings</span></span>
    <span class="hs-round hs-list-search"><ProductIcon name="search" /></span>
    <span class="hs-list-tool"><ProductIcon name="funnel" /></span>
  </div>
  <div class="hs-projects">
    <div class="hs-project">
      <span class="hs-project-head"><ProductIcon name="globe" /><span class="hs-project-name">Workspace</span><span class="hs-project-meta">No threads</span></span>
    </div>
    <div class="hs-project">
      <span class="hs-project-head">
        <ProductIcon name="folderOpen" />
        <span class="hs-project-name">{project.name}</span>
        <span class="hs-project-meta">
          <span data-running="0">{studio.length} threads</span>
          {Array.from({ length: running }, (_, i) => <span data-running={i + 1}>{i + 1} running</span>)}
          {needs ? <span data-needs>Needs you</span> : null}
        </span>
      </span>
      <div class="hs-project-threads">
        {studio.map((row) => (
          <span class="hs-row" data-row={row.id} data-current={row.current ? "" : undefined} data-grow={row.show ? "" : undefined} {...stateAttributes(row)} {...(row.show ? show(row.show) : {})}>
            <span class="hs-row-head">
              <span class="hs-row-status"><ProductIcon name="loader" />{row.waiting ? <ProductIcon name="circleHelp" class="hs-row-waiting" /> : null}</span>
              <span class="hs-row-title">{row.title}</span>
            </span>
            <span class="hs-row-headline">
              {Array.isArray(row.headline) ? row.headline.map((step) => <span {...show(step.show)}>{step.text}</span>) : (row.headline ?? "Working")}
            </span>
          </span>
        ))}
      </div>
    </div>
    <div class="hs-project">
      <span class="hs-project-head"><ProductIcon name="folderOpen" /><span class="hs-project-name">website</span><span class="hs-project-meta">1 thread</span></span>
      <div class="hs-project-threads">
        <span class="hs-row"><span class="hs-row-head"><span class="hs-row-status"></span><span class="hs-row-title">Tell the product story</span></span></span>
      </div>
    </div>
    <div class="hs-project">
      <span class="hs-project-head"><ProductIcon name="folder" /><span class="hs-project-name">atlas-api</span><span class="hs-project-meta">1 thread</span></span>
    </div>
  </div>
  <div class="hs-sidebar-foot">
    <span class="hs-add-project"><ProductIcon name="plus" />Add project</span>
    <div class="hs-account">
      <span class="hs-usage">
        <svg class="hs-ring" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" /><circle cx="8" cy="8" r="6" pathLength="100" stroke-dasharray={`${usage} 100`} transform="rotate(-90 8 8)" /></svg>
        <span class="hs-usage-value">{usage}%</span>
        <span class="hs-usage-label">left this week</span>
      </span>
      <span class="hs-round"><ProductIcon name="settings" /></span>
    </div>
  </div>
</aside>
