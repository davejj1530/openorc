{
  "name": "@openorc/link",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "The encrypted session between OpenOrc on a Mac and a paired phone: Noise IK over a WebSocket, records, messages and the pairing code.",
  "exports": {
