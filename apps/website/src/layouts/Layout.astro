---
import textFont from "../assets/fonts/ImmaculateGothic-Text.woff2?url";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  wide?: boolean;
}
const {
  title = "OpenOrc — Your coding agents, working together",
  description = "Bring Codex, Claude Code, and OpenCode into one desktop workspace. Share context between threads, discuss tasks, and review code where the work happens.",
  noindex = false,
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6QFDF6RQ6B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-6QFDF6RQ6B');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f7f7f4" />
    <script is:inline>
      // Before the first paint: the saved theme, or the system's until one is chosen.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("openorc-site-theme");
        } catch {}
        const theme = saved === "dark" || saved === "light" ? saved : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').setAttribute("content", theme === "dark" ? "#151410" : "#f7f7f4");
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <title>{title}</title>
  </head>
  <body class:list={{ "site-home": Astro.url.pathname === "/", "site-wide": wide }}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
