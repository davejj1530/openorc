---
/**
 * One conversation pane as the app draws it (ThreadView.tsx): the title and its faint facts in the header with the
 * round pane buttons, the transcript ending in the OpenOrc cube, and the composer. The `presence` slot sits beside
 * the cube, as a team's working clock does.
 */
import Composer from "./Composer.astro";
import PresenceMark from "./PresenceMark.astro";
import ProductIcon from "./ProductIcon.astro";
import { project } from "../../data/hero/workspace";
import { flagged } from "../../data/hero/timeline";
import type { ComponentProps } from "astro/types";

type ComposerProps = ComponentProps<typeof Composer>;

interface Props extends Omit<ComposerProps, "layout"> {
  id: string;
  title: string;
  /** Windows during which the thread's agent is working; stills pass none. */
  busy?: string;
  /** The work panel is open beside the thread, so its toggle shows as on. */
  panel?: boolean;
}
const { id, title, busy, panel, ...composer } = Astro.props;
const { journey } = composer;
---

<section class="hs-pane" data-pane={id} {...(busy && journey ? flagged(journey, { busy }) : {})}>
  <header class="hs-header">
    <span class="hs-title">{title}</span>
    <span class="hs-facts">
      <span>{project.name}</span>
      <span class="hs-fact-working"><i></i>working</span>
    </span>
    <span class="hs-header-actions">
      <slot name="status" />
      <span class="hs-round hs-close-pane"><ProductIcon name="close" /></span>
      <span class="hs-round"><ProductIcon name="more" /></span>
      <span class="hs-round"><ProductIcon name="tasks" /></span>
      <span class="hs-round" data-on={panel ? "" : undefined}><ProductIcon name="panelRight" /></span>
    </span>
  </header>
  <div class="hs-transcript">
    <div class="hs-column">
      <slot />
      <PresenceMark><slot name="presence" /></PresenceMark>
    </div>
  </div>
  <div class="hs-composer-area">
    <slot name="hint" />
    <Composer {...composer} />
  </div>
</section>
