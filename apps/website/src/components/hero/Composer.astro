---
/**
 * The message composer as the app draws it (Composer.tsx): one plane with the prompt over a bar of attach, model and
 * mode pills, the context ring and send; under it, the conversation's folder beside its branch and the Commit chip
 * with the checkout's uncommitted lines. The new-thread page's composer is larger, names the project in the bar, and
 * leaves the folder row to the page.
 */
import Counts from "./Counts.astro";
import ProductIcon from "./ProductIcon.astro";
import { project } from "../../data/hero/workspace";
import { flagged, timed, type Journey } from "../../data/hero/timeline";

interface Props {
  /** The scene's journey; stills pass none. */
  journey?: Journey;
  placeholder: string;
  model: { label: string; effort: string; harness?: string; icon?: "team" };
  permission: string;
  branch?: string;
  /** Window during which uncommitted changes show beside the branch, with their counts; `true` for the whole scene. */
  changes?: string | boolean;
  changeStat?: { added: number; removed: number };
  /** The prompt this composer types, if any. */
  prompt?: { text: string; typo: { at: number; key: string }; window: string; typed: string };
  /** How much of the context window the conversation uses, as the ring shows it. Teams have none. */
  context?: number | null;
  layout?: "thread" | "new";
}
const { journey, placeholder, model, permission, branch = project.branch, changes, changeStat = { added: 8, removed: 2 }, prompt, context = 18, layout = "thread" } = Astro.props;
const fresh = layout === "new";
const ring = 2 * Math.PI * 6;
---

<div class="hs-composer" data-layout={layout} {...(prompt && journey ? flagged(journey, { typed: prompt.typed }) : {})}>
  <div class="hs-shell">
    <div class="hs-prompt">
      <span class="hs-placeholder hs-placeholder-idle">{placeholder}</span>
      <span class="hs-placeholder hs-placeholder-busy">Say it during this turn…</span>
      {prompt && journey ? <span class="hs-typed" data-type={prompt.window} data-text={prompt.text} data-typo={`${prompt.typo.at}:${prompt.typo.key}`} {...timed(journey, prompt.typed)} /> : null}
      {prompt ? <span class="hs-caret" /> : null}
    </div>
    <div class="hs-bar">
      <span class="hs-attach"><ProductIcon name="plus" /></span>
      {fresh ? <span class="hs-pill"><ProductIcon name="folder" />{project.name}<ProductIcon name="chevronDown" class="hs-pill-chevron" /></span> : null}
      <span class="hs-pill hs-model">
        {model.icon ? <ProductIcon name={model.icon} /> : <svg class="hs-logo" data-provider={model.harness} aria-hidden="true"><use href={`#hs-logo-${model.harness}`} /></svg>}
        <span class="hs-model-name">{model.label}</span>
        <span class="hs-model-effort">{model.effort}</span>
      </span>
      <span class="hs-pill hs-mode"><ProductIcon name="pencil" /><span>{permission}</span></span>
      <span class="hs-bar-end">
        {!fresh && context !== null ? (
          <span class="hs-context">
            <svg class="hs-ring" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" /><circle cx="8" cy="8" r="6" stroke-dasharray={`${(context / 100) * ring} ${ring}`} transform="rotate(-90 8 8)" /></svg>
            <span>{context}%</span>
          </span>
        ) : null}
        <span class="hs-send">
          <ProductIcon name="arrowUp" class="hs-send-arrow" />
          <span class="hs-send-stop" />
        </span>
      </span>
    </div>
  </div>
  {fresh ? null : (
    <div class="hs-rail">
      <span class="hs-directory"><ProductIcon name="folder" /><span>/Projects/{project.name}</span></span>
      <span class="hs-branch"><ProductIcon name="branch" /><span>{branch}</span></span>
      {changes ? (
        <span class="hs-commit" {...(typeof changes === "string" && journey ? timed(journey, changes) : {})}>
          <span class="hs-commit-label">Commit</span>
          <Counts {...changeStat} />
        </span>
      ) : null}
    </div>
  )}
</div>
