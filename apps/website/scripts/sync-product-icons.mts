/**
 * Writes src/data/product-icons.ts from the desktop app's icon set, so the product pictures draw the app's own glyphs.
 * Run `pnpm --filter @openorc/website icons:sync` after the app's icons change; `--check` fails when the file is stale.
 */
import { readFileSync, writeFileSync } from "node:fs";
import { createRequire } from "node:module";
import { fileURLToPath } from "node:url";
import { format, resolveConfig } from "prettier";

const source = fileURLToPath(new URL("../../desktop/src/renderer/src/components/icons.tsx", import.meta.url));
const output = fileURLToPath(new URL("../src/data/product-icons.ts", import.meta.url));
const desktop = createRequire(source);
// The desktop's own React draws each icon, so the website needs none of its own.
const { renderToStaticMarkup } = desktop("react-dom/server") as { renderToStaticMarkup(element: unknown): string };
const { createElement } = desktop("react") as { createElement(component: unknown): unknown };

const icons = (await import(source)) as Record<string, unknown>;
const camel = (name: string) => name[0]!.toLowerCase() + name.slice(1);
const geometry = (Icon: unknown) => renderToStaticMarkup(createElement(Icon)).replace(/^<svg[^>]*>|<\/svg>$/g, "");
const entries = Object.entries(icons)
  .filter(([name, Icon]) => /^[A-Z]/.test(name) && typeof Icon === "object")
  .map(([name, Icon]) => `  ${camel(name)}: ${JSON.stringify(geometry(Icon))},`)
  .sort();

const draft = `/** Generated by scripts/sync-product-icons.mts from the desktop app's icons.tsx. Do not edit by hand. */
export const productIcons = {
${entries.join("\n")}
} as const;

export type ProductIconName = keyof typeof productIcons;
`;
// Written as the repository formats it, so the format check and this check agree.
const file = await format(draft, { ...(await resolveConfig(output)), filepath: output });

if (process.argv.includes("--check")) {
  if (readFileSync(output, "utf8") !== file) {
    console.error("src/data/product-icons.ts is behind the desktop app's icons. Run: pnpm --filter @openorc/website icons:sync");
    process.exit(1);
  }
} else {
  writeFileSync(output, file);
  console.log(`Wrote ${entries.length} icons to src/data/product-icons.ts`);
}
