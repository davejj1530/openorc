---
/**
 * The app's navigation as Sidebar.tsx lays it out. On the window's top line, the sidebar toggle after the window
 * controls, then Back and Forward (off, with nothing to go forward to). Under it the screens as rows: New thread,
 * Tasks with the tasks waiting for review, Pull requests and Schedules. Then the list's name, which switches what the
 * list holds, with search, a new folder and the filter, and each project's threads under its open cube
 * (SidebarProjectGroup.tsx), one line a thread (ThreadLibraryRow.tsx): the cube of its state leads, as dots at work,
 * in the attention colour while it waits on you and whole while a finished turn is unread, then its title. Today's
 * threads lead a project, Yesterday's follow under their label, and each project ends with its own Resolved. Settings
 * stands at the foot. Stills pass no journey.
 */
import ProductIcon from "./ProductIcon.astro";
import ProjectCube from "./ProjectCube.astro";
import StateMark from "./StateMark.astro";
import { otherThreads, project, projects, type SidebarRow } from "../../data/hero/workspace";
import { flagged, timed, type Journey } from "../../data/hero/timeline";

interface Props {
  /** The scene's journey; stills pass none. */
  journey?: Journey;
  /** The scene's own threads, listed ahead of the shared ones. */
  rows: SidebarRow[];
}
const { journey, rows } = Astro.props;
const listed = [...rows, ...otherThreads.filter((thread) => !rows.some((row) => row.title === thread.title))];
const show = (windows: string) => (journey ? timed(journey, windows) : {});
/** A still's states are `true` and always hold; a scene's are windows the player toggles. A finished, unread turn always shows. */
const stateAttributes = (states: Pick<SidebarRow, "busy" | "waiting" | "done">) => {
  const windows = Object.fromEntries(Object.entries({ busy: states.busy, waiting: states.waiting }).filter((entry): entry is [string, string] => typeof entry[1] === "string"));
  return {
    ...(states.busy === true ? { "data-busy": "" } : {}),
    ...(states.waiting === true ? { "data-waiting": "" } : {}),
    ...(states.done ? { "data-done": "" } : {}),
    ...(journey && Object.keys(windows).length ? flagged(journey, windows) : {}),
  };
};
/** A project is at work while any of its threads is, and wants the person while one waits. */
const together = (group: SidebarRow[], state: "busy" | "waiting") => {
  const held = group.map((row) => row[state]).filter((value) => value !== undefined);
  return held.includes(true) ? true : held.length ? held.join(" ") : undefined;
};
const groups = projects.map((group) => {
  const own = listed.filter((row) => (row.project ?? project.name) === group.name);
  const shown = group.folded ? [] : own;
  return {
    ...group,
    states: stateAttributes({ busy: together(own, "busy"), waiting: together(own, "waiting") }),
    days: [
      { label: undefined, rows: shown.filter((row) => !row.day) },
      { label: "Yesterday", rows: shown.filter((row) => row.day === "yesterday") },
    ].filter((day) => day.rows.length),
  };
});
/** Tasks ready for review, the count the Tasks row carries. */
const review = 2;
const screens = [
  { id: "newthread", icon: "penSquare", label: "New thread" },
  { id: "tasks", icon: "listTodo", label: "Tasks", count: review },
  { id: "pulls", icon: "gitPullRequest", label: "Pull requests" },
  { id: "scheduled", icon: "calendarClock", label: "Schedules" },
] as const;
---

<aside class="hs-sidebar" aria-hidden="true">
  <div class="hs-sidebar-head">
    <span class="hs-round hs-sidebar-toggle"><ProductIcon name="panelLeft" /></span>
    <span class="hs-history">
      <span class="hs-round"><ProductIcon name="arrowLeft" /></span>
      <span class="hs-round" data-off><ProductIcon name="arrowRight" /></span>
    </span>
  </div>
  <nav class="hs-nav">
    {
      screens.map((screen) => (
        <span class="hs-nav-row" data-screen={screen.id}>
          <ProductIcon name={screen.icon} />
          <span class="hs-nav-label">{screen.label}</span>
          {"count" in screen ? <span class="hs-nav-count">{screen.count}</span> : null}
        </span>
      ))
    }
  </nav>
  <div class="hs-list-head">
    <span class="hs-list-name">My workspaces<ProductIcon name="chevronsUpDown" /></span>
    <span class="hs-list-tools">
      <span class="hs-round"><ProductIcon name="search" /></span>
      <span class="hs-round"><ProductIcon name="folderPlus" /></span>
      <span class="hs-round"><ProductIcon name="funnel" /></span>
    </span>
  </div>
  <div class="hs-threads">
    {
      groups.map((group) => (
        <div class="hs-project" data-folded={group.folded ? "" : undefined}>
          <span class="hs-project-head" {...group.states}>
            <ProjectCube />
            <span class="hs-project-name">{group.name}</span>
            {group.folded ? <ProductIcon name="chevronRight" class="hs-project-chevron" /> : null}
          </span>
          {group.days.map((day) => (
            <>
              {day.label ? <span class="hs-day">{day.label}</span> : null}
              {day.rows.map((row) => (
                <span class="hs-row" data-row={row.id} data-current={row.current ? "" : undefined} data-grow={row.show ? "" : undefined} {...stateAttributes(row)} {...(row.show ? show(row.show) : {})}>
                  <span class="hs-row-lead">
                    {row.busy ? <StateMark class="hs-row-busy" /> : null}
                    {row.waiting ? <StateMark kind="question" class="hs-row-waiting" /> : null}
                    {row.done ? <StateMark kind="done" class="hs-row-done" /> : null}
                  </span>
                  <span class="hs-row-title">{row.title}</span>
                </span>
              ))}
            </>
          ))}
          {group.folded ? null : <span class="hs-resolved">Resolved<ProductIcon name="chevronRight" /></span>}
        </div>
      ))
    }
  </div>
  <div class="hs-sidebar-foot">
    <span class="hs-round"><ProductIcon name="settings" /></span>
  </div>
</aside>
