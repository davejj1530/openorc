---
/**
 * The app's navigation as Sidebar.tsx lays it out. On the window's top line, the OpenOrc wordmark after the window
 * controls with Inbox and the sidebar toggle. Under it, a rail: New thread, the screens (Tasks, Pull requests,
 * Schedules, Orclings), Projects after a short divider, and at its foot the open thread's weekly usage as a ring, then
 * updates and Settings; beside the rail, the thread list: the project filter, Search with the filter and New thread,
 * one list of threads by day with Yesterday folded, and the Resolved drawer at its foot. A row is its title, what the
 * agent is doing while it works (its title lit by a moving band, a spinner at the line's end), or an amber call while
 * it waits on you, then its project and where it works. Stills pass no journey.
 */
import ProductIcon, { type IconName } from "./ProductIcon.astro";
import { days, otherThreads, project, type SidebarRow } from "../../data/hero/workspace";
import { flagged, timed, type Journey } from "../../data/hero/timeline";

interface Usage {
  /** Percent of the week left on the open thread's account. */
  left: number;
  /** The threads whose account it is, for a still whose open thread changes. */
  for?: string;
  hidden?: boolean;
}

interface Props {
  /** The scene's journey; stills pass none. */
  journey?: Journey;
  /** The scene's own threads, listed ahead of the shared ones. */
  rows: SidebarRow[];
  /** Window during which an agent's question waits in the Inbox. */
  inboxPending?: string;
  usage?: Usage[];
}
const { journey, rows, inboxPending, usage = [{ left: 64 }] } = Astro.props;
const listed = [...rows, ...otherThreads.filter((thread) => !rows.some((row) => row.title === thread.title))];
const sections = days.map((day) => ({ ...day, rows: day.folded ? [] : listed.filter((row) => (row.day ?? "recent") === day.id) }));
const show = (windows: string) => (journey ? timed(journey, windows) : {});
/** A still's states are `true` and always hold; a scene's are windows the player toggles. A finished, unread turn always shows. */
const stateAttributes = ({ busy, waiting, done }: SidebarRow) => {
  const windows = Object.fromEntries(Object.entries({ busy, waiting }).filter((entry): entry is [string, string] => typeof entry[1] === "string"));
  return {
    ...(busy === true ? { "data-busy": "" } : {}),
    ...(waiting === true ? { "data-waiting": "" } : {}),
    ...(done ? { "data-done": "" } : {}),
    ...(journey && Object.keys(windows).length ? flagged(journey, windows) : {}),
  };
};
const inbox = 2;
const [pendingFrom, pendingTo] = inboxPending?.split("~") ?? [];
const resolved = 14;
const screens: { id: string; icon: IconName }[] = [
  { id: "tasks", icon: "tasks" },
  { id: "pulls", icon: "gitPullRequest" },
  { id: "scheduled", icon: "scheduled" },
  { id: "orclings", icon: "orclings" },
];
---

<aside class="hs-sidebar" aria-hidden="true">
  <div class="hs-sidebar-head">
    <span class="hs-wordmark">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M17.91 2.5L26.74 7.6Q28.64 8.7 28.64 10.9L28.64 21.1Q28.64 23.3 26.74 24.4L17.91 29.5Q16 30.6 14.09 29.5L5.26 24.4Q3.36 23.3 3.36 21.1L3.36 10.9Q3.36 8.7 5.26 7.6L14.09 2.5Q16 1.4 17.91 2.5ZM16.78 4.27L23.66 8.25Q24.44 8.7 23.66 9.15L16.43 13.33Q16 13.58 15.57 13.33L8.34 9.15Q7.56 8.7 8.34 8.25L15.22 4.27Q16 3.82 16.78 4.27Z" /></svg>
      <span>OpenOrc</span>
    </span>
    <span class="hs-round hs-inbox">
      <ProductIcon name="inbox" />
      <span class="hs-inbox-count">
        {inboxPending ? <span {...show(`<${pendingFrom} >${pendingTo}`)}>{inbox}</span> : inbox}
        {inboxPending ? <span {...show(inboxPending)}>{inbox + 1}</span> : null}
      </span>
    </span>
    <span class="hs-round"><ProductIcon name="panelLeft" /></span>
  </div>
  <div class="hs-sidebar-body">
    <nav class="hs-sidebar-rail">
      <span class="hs-rail-button" data-screen="newthread"><ProductIcon name="compose" /></span>
      {screens.map((screen) => <span class="hs-rail-button" data-screen={screen.id}><ProductIcon name={screen.icon} /></span>)}
      <span class="hs-rail-divider"></span>
      <span class="hs-rail-button"><ProductIcon name="layers" /></span>
      <span class="hs-rail-gap"></span>
      {usage.map(({ left, for: owners, hidden }) => (
        <span class="hs-rail-button hs-rail-usage" data-for={owners} hidden={hidden}>
          <svg class="hs-ring" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" /><circle cx="8" cy="8" r="6" pathLength="100" stroke-dasharray={`${left} 100`} transform="rotate(-90 8 8)" /></svg>
        </span>
      ))}
      <span class="hs-rail-button"><ProductIcon name="download" /></span>
      <span class="hs-rail-button"><ProductIcon name="settings" /></span>
    </nav>
    <div class="hs-workspace">
      <span class="hs-workspace-name"><ProductIcon name="layers" /><span>All projects</span><ProductIcon name="chevronDown" /></span>
      <div class="hs-list-head">
        <span class="hs-search"><ProductIcon name="search" />Search</span>
        <span class="hs-round"><ProductIcon name="funnel" /></span>
        <span class="hs-round hs-list-new"><ProductIcon name="compose" /></span>
      </div>
      <div class="hs-threads">
        {sections.map((section) => (
          <div class="hs-day" data-folded={section.folded ? "" : undefined}>
            <span class="hs-day-head">{section.label}<ProductIcon name="chevronRight" /></span>
            {section.rows.map((row) => (
              <span class="hs-row" data-row={row.id} data-current={row.current ? "" : undefined} data-grow={row.show ? "" : undefined} {...stateAttributes(row)} {...(row.show ? show(row.show) : {})}>
                <span class="hs-row-heading">
                  <span class="hs-row-title">{row.title}</span>
                  {row.waiting ? <ProductIcon name="circleHelp" class="hs-row-question" /> : null}
                  {row.done ? <i class="hs-row-dot" /> : null}
                </span>
                {row.busy || row.waiting || row.done ? (
                  <span class="hs-row-line">
                    {row.busy ? (
                      <span class="hs-row-headline">
                        {Array.isArray(row.headline) ? row.headline.map((step) => <span {...show(step.show)}>{step.text}</span>) : (row.headline ?? "Working")}
                      </span>
                    ) : null}
                    {row.waiting ? <span class="hs-row-ask">Has a question for you</span> : null}
                    {row.done ? <span class="hs-row-done">Done · {row.done}</span> : null}
                    {row.busy ? <ProductIcon name="loader" class="hs-row-spinner" /> : null}
                  </span>
                ) : null}
                <span class="hs-row-project">
                  <ProductIcon name="folder" />
                  <span>{row.project ?? project.name}</span>
                  <span class="hs-row-place">{row.branch ? "worktree" : project.branch}</span>
                </span>
              </span>
            ))}
          </div>
        ))}
      </div>
      <div class="hs-resolved">
        <span>Resolved</span>
        <span class="hs-resolved-count">{resolved}</span>
        <ProductIcon name="chevronRight" />
      </div>
    </div>
  </div>
</aside>
