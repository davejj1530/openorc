---
import { agents } from "../../data/agents";
---

<div class="docs-table">
  <table>
    <thead><tr><th scope="col">Agent</th><th scope="col">Start in a terminal</th><th scope="col">Account or key</th></tr></thead>
    <tbody>
      {agents.map((agent) => (
        <tr><th scope="row"><a href={agent.setup}>{agent.name}</a></th><td><code>{agent.login}</code></td><td>{agent.account}</td></tr>
      ))}
    </tbody>
  </table>
</div>
