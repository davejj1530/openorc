---
/**
 * The app's navigation as Sidebar.tsx lays it out. On the window's top line, the OpenOrc wordmark after the window
 * controls, then Back and Forward (off, with nothing to go forward to). Under it the screens as rows: New thread,
 * Tasks with the tasks waiting for review, Pull requests, Schedules and Orclings. Then Workspaces with search, a new
 * folder and the filter, and each project's threads under its folder, one line a thread (ThreadLibraryRow.tsx): its
 * title and, at the line's end, the working cube while its agent works, an amber question while it waits on you, an
 * ink dot while a finished turn is unread. Resolved at the list's foot, and under it the open thread's weekly usage
 * and Settings. Stills pass no journey.
 */
import AskMark from "./AskMark.astro";
import ProductIcon from "./ProductIcon.astro";
import SharePie from "./SharePie.astro";
import WorkingCube from "./WorkingCube.astro";
import { otherThreads, project, projects, type SidebarRow } from "../../data/hero/workspace";
import { flagged, timed, type Journey } from "../../data/hero/timeline";

interface Usage {
  /** Percent of the week left on the open thread's account. */
  left: number;
  /** The threads whose account it is, for a still whose open thread changes. */
  for?: string;
  hidden?: boolean;
}

interface Props {
  /** The scene's journey; stills pass none. */
  journey?: Journey;
  /** The scene's own threads, listed ahead of the shared ones. */
  rows: SidebarRow[];
  usage?: Usage[];
}
const { journey, rows, usage = [{ left: 64 }] } = Astro.props;
const listed = [...rows, ...otherThreads.filter((thread) => !rows.some((row) => row.title === thread.title))];
const groups = projects.map((group) => ({ ...group, rows: group.folded ? [] : listed.filter((row) => (row.project ?? project.name) === group.name) }));
const show = (windows: string) => (journey ? timed(journey, windows) : {});
/** A still's states are `true` and always hold; a scene's are windows the player toggles. A finished, unread turn always shows. */
const stateAttributes = ({ busy, waiting, done }: SidebarRow) => {
  const windows = Object.fromEntries(Object.entries({ busy, waiting }).filter((entry): entry is [string, string] => typeof entry[1] === "string"));
  return {
    ...(busy === true ? { "data-busy": "" } : {}),
    ...(waiting === true ? { "data-waiting": "" } : {}),
    ...(done ? { "data-done": "" } : {}),
    ...(journey && Object.keys(windows).length ? flagged(journey, windows) : {}),
  };
};
/** Tasks ready for review, the count the Tasks row carries. */
const review = 2;
const screens = [
  { id: "tasks", icon: "tasks", label: "Tasks", count: review },
  { id: "pulls", icon: "gitPullRequest", label: "Pull requests" },
  { id: "scheduled", icon: "scheduled", label: "Schedules" },
  { id: "orclings", icon: "orclings", label: "Orclings" },
] as const;
---

<aside class="hs-sidebar" aria-hidden="true">
  <div class="hs-sidebar-head">
    <span class="hs-wordmark">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M17.91 2.5L26.74 7.6Q28.64 8.7 28.64 10.9L28.64 21.1Q28.64 23.3 26.74 24.4L17.91 29.5Q16 30.6 14.09 29.5L5.26 24.4Q3.36 23.3 3.36 21.1L3.36 10.9Q3.36 8.7 5.26 7.6L14.09 2.5Q16 1.4 17.91 2.5ZM16.78 4.27L23.66 8.25Q24.44 8.7 23.66 9.15L16.43 13.33Q16 13.58 15.57 13.33L8.34 9.15Q7.56 8.7 8.34 8.25L15.22 4.27Q16 3.82 16.78 4.27Z" /></svg>
      <span>OpenOrc</span>
    </span>
    <span class="hs-round"><ProductIcon name="arrowLeft" /></span>
    <span class="hs-round" data-off><ProductIcon name="arrowRight" /></span>
  </div>
  <nav class="hs-nav">
    <span class="hs-nav-row" data-screen="newthread"><ProductIcon name="compose" /><span>New thread</span></span>
    {
      screens.map((screen) => (
        <span class="hs-nav-row" data-screen={screen.id}>
          <ProductIcon name={screen.icon} />
          <span>{screen.label}</span>
          {"count" in screen ? <span class="hs-nav-count">{screen.count}</span> : null}
        </span>
      ))
    }
  </nav>
  <div class="hs-list-head">
    <span class="hs-list-name">Workspaces</span>
    <span class="hs-list-tools"><ProductIcon name="search" /><ProductIcon name="folderPlus" /><ProductIcon name="funnel" /></span>
  </div>
  <div class="hs-threads">
    {
      groups.map((group) => (
        <div class="hs-project" data-folded={group.folded ? "" : undefined}>
          <span class="hs-project-head">
            <ProductIcon name="folder" />
            <span>{group.name}</span>
            {group.folded ? <ProductIcon name="chevronRight" /> : null}
          </span>
          {group.rows.map((row) => (
            <span class="hs-row" data-row={row.id} data-current={row.current ? "" : undefined} data-grow={row.show ? "" : undefined} {...stateAttributes(row)} {...(row.show ? show(row.show) : {})}>
              <span class="hs-row-title">{row.title}</span>
              {row.busy ? <WorkingCube class="hs-row-cube" /> : null}
              {row.waiting ? <AskMark class="hs-row-question" /> : null}
              {row.done ? <i class="hs-row-dot" /> : null}
            </span>
          ))}
        </div>
      ))
    }
  </div>
  <div class="hs-resolved"><span>Resolved</span><ProductIcon name="chevronRight" /></div>
  <div class="hs-sidebar-foot">
    {
      usage.map(({ left, for: owners, hidden }) => (
        <span class="hs-usage" data-for={owners} hidden={hidden}>
          <SharePie fraction={left / 100} />
          {left}%
        </span>
      ))
    }
    <span class="hs-round"><ProductIcon name="settings" /></span>
  </div>
</aside>
