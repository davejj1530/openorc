---
import Icon from "./Icon.astro";
import DownloadButton from "./DownloadButton.astro";
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SoundToggle from "./SoundToggle.astro";
import SearchDialog from "./SearchDialog.astro";
import { getPublishedReleases } from "../data/changelog";
const docs = Astro.url.pathname.startsWith("/docs");
const changelog = Astro.url.pathname.startsWith("/changelog");
const hasPublishedReleases = (await getPublishedReleases()).length > 0;
const home = Astro.url.pathname === "/" ? "" : "/";
---

<header class="site-header">
  <nav class="container nav" aria-label="Main navigation">
    <div class="nav-start">
      <a class="wordmark" href="/" aria-label="OpenOrc home">
        <BrandMark />
        OpenOrc
      </a>
      <div class="nav-links">
        <a class="nav-secondary" href={`${home}#workflow`}>
          Workflow
        </a>
        <a class="nav-secondary" href={`${home}#your-tools`}>
          Your setup
        </a>
        <a href="/docs/" aria-current={docs ? "page" : undefined}>
          Docs
        </a>
        {
          hasPublishedReleases && (
            <a class="nav-changelog" href="/changelog/" aria-current={changelog ? "page" : undefined}>
              Changelog
            </a>
          )
        }
      </div>
    </div>
    <button class="search-pill" type="button" aria-label="Search" aria-haspopup="dialog" aria-expanded="false" aria-controls="site-search" data-search-pill>
      <Icon name="search" size={18} />
      <span class="search-label">Search</span>
      <kbd class="search-key" data-search-key>⌘K</kbd>
    </button>
    <div class="nav-actions">
      <SoundToggle />
      <ThemeToggle />
      <a class="icon-button" href="https://github.com/davejj1530/openorc" aria-label="OpenOrc on GitHub" target="_blank" rel="noopener noreferrer">
        <Icon name="github" size={18} />
      </a>
      <DownloadButton compact />
    </div>
  </nav>
</header>
<SearchDialog />

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    const updateHeader = () => {
      header.toggleAttribute("data-at-top", window.scrollY <= 0);
    };
    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });
    window.addEventListener("pageshow", updateHeader);
  }
</script>
