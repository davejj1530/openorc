---
/**
 * The Changes page's content (Panel.tsx, DiffView.tsx): the Uncommitted bar with Commit, then each changed file under
 * its head, open with its diff or folded to the head. Rows follow the app's unified view: line numbers, soft runs of
 * additions and removals, no syntax colors.
 */
import Counts from "./Counts.astro";
import ProductIcon from "./ProductIcon.astro";
import { welcomeDiff, type DiffFile } from "../../data/hero/diffs";

interface Props {
  files?: DiffFile[];
}
const { files = [welcomeDiff] } = Astro.props;
const total = files.reduce((sum, file) => ({ added: sum.added + file.added, removed: sum.removed + file.removed }), { added: 0, removed: 0 });
/** A run of changed lines rounds its ends, and a run that follows another kind of change starts a little apart. */
const rows = (lines: NonNullable<DiffFile["lines"]>) =>
  lines.map(([type, number, code], i) => ({
    type,
    number,
    code,
    first: type !== "context" && lines[i - 1]?.[0] !== type,
    last: type !== "context" && lines[i + 1]?.[0] !== type,
  }));
const split = (path: string) => [path.slice(0, path.lastIndexOf("/") + 1), path.slice(path.lastIndexOf("/") + 1)];
---

<div class="hs-panel-bar">
  <span class="hs-panel-title">Uncommitted</span>
  <span class="hs-panel-meta">{files.length} {files.length === 1 ? "file" : "files"}</span>
  <Counts {...total} />
  <span class="hs-round hs-panel-refresh"><ProductIcon name="refresh" /></span>
  <span class="hs-button hs-button-ink">Commit</span>
</div>
{files.map((file) => (
  <section class="hs-diff-file">
    <div class="hs-diff-head">
      <ProductIcon name={file.lines ? "chevronDown" : "chevronRight"} />
      <span class="hs-diff-letter">{file.letter ?? "M"}</span>
      <span class="hs-diff-path"><span>{split(file.path)[0]}</span>{split(file.path)[1]}</span>
      <Counts added={file.added} removed={file.removed} />
    </div>
    {file.lines ? (
      <div class="hs-diff">
        {rows(file.lines).map((row) => (
          <div class="hs-diff-row" data-type={row.type} data-first={row.first ? "" : undefined} data-last={row.last ? "" : undefined}>
            <span class="hs-diff-num">{row.number}</span>
            <span class="hs-diff-code">{row.code}</span>
          </div>
        ))}
      </div>
    ) : null}
  </section>
))}
