+/**
+ * Whether a sandboxed page may load now. Its rules go into its web view before the first load, which follows as soon
+ * as they are ready (at once once they have been compiled); where the sandbox cannot hold, the page never loads and
+ * the web view says why.
+ */
+- (BOOL)prepareSandbox
+{
+  if (_sandboxRulesAdded) {
+    return YES;
+  }
+  if (@available(iOS 17.0, macOS 14.0, *)) {
+    __weak RNCWebViewImpl *weakSelf = self;
+    RNCWithSandboxRules(^(WKContentRuleList *rules) {
+      RNCWebViewImpl *strongSelf = weakSelf;
+      if (!strongSelf || !strongSelf->_webView || strongSelf->_sandboxRulesAdded) {
+        return;
+      }
+      if (!rules) {
+        [strongSelf failSandbox:@"The page's sandbox could not be set up."];
+        return;
+      }
+      [strongSelf->_webView.configuration.userContentController addContentRuleList:rules];
+      strongSelf->_sandboxRulesAdded = YES;
+      [strongSelf visitSource];
+    });
+  } else {
+    [self failSandbox:@"This system cannot keep the page offline."];
+  }
+  return NO;
+}
+
