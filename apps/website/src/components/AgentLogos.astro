---
import { agents } from "../data/agents";
import AgentMark from "./AgentMark.astro";
---

<p class="works-with">
  <span>Works with</span>
  <span class="works-with-marks">
    {agents.map((agent) => (
      <span class="works-with-agent" role="img" aria-label={agent.name} title={agent.name}>
        <AgentMark id={agent.id} size={20} />
      </span>
    ))}
  </span>
</p>

<style>
  .works-with { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; color: var(--faint); font-size: 0.8125rem; line-height: 1.6; }
  .works-with-marks { display: inline-flex; align-items: center; gap: 16px; }
  .works-with-agent { display: inline-flex; flex: none; }
  @media (max-width: 480px) {
    .works-with-marks { gap: 12px; }
  }
</style>
